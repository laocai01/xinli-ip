[
 {
  "start": 0.43,
  "end": 4.27,
  "text": "你不是不想说话,是说了也没人接"
 },
 {
  "start": 4.27,
  "end": 8.63,
  "text": "你再加上想说话,说了三句就没人接了"
 },
 {
  "start": 8.63,
  "end": 15.43,
  "text": "你回忆一下,昨天晚上,你想说个事"
 },
 {
  "start": 15.43,
  "end": 18.99,
  "text": "可能是当问你的一件比较憋屈的事,比较委屈的事"
 },
 {
  "start": 18.99,
  "end": 20.19,
  "text": "你看那个头"
 },
 {
  "start": 20.19,
  "end": 22.43,
  "text": "今天那个谁又"
 },
 {
  "start": 22.43,
  "end": 25.63,
  "text": "老婆在发手机的医生"
 },
 {
  "start": 25.63,
  "end": 27.79,
  "text": "还只在写作业,头都没弹"
 },
 {
  "start": 27.79,
  "end": 30.11,
  "text": "你说到第三句,自己停了"
 },
 {
  "start": 30.11,
  "end": 32.83,
  "text": "然后你端起碗,把饭吃完"
 },
 {
  "start": 33.11,
  "end": 35.95,
  "text": "我跟你说,这个场景比吵架还三"
 },
 {
  "start": 35.95,
  "end": 38.91,
  "text": "吵起架,至少还有人跟你对着干"
 },
 {
  "start": 38.91,
  "end": 41.47,
  "text": "没有人接话是那种,我在这"
 },
 {
  "start": 41.47,
  "end": 46.39,
  "text": "但没有人在,没有人在的感觉"
 },
 {
  "start": 46.39,
  "end": 48.35,
  "text": "我认识一个老哥,50岁"
 },
 {
  "start": 48.35,
  "end": 50.11,
  "text": "在单位是当个小头的"
 },
 {
  "start": 50.11,
  "end": 53.47,
  "text": "他说他有一次在饭桌上讲了单位的事情"
 },
 {
  "start": 53.47,
  "end": 54.23,
  "text": "讲到一半"
 },
 {
  "start": 54.23,
  "end": 57.63,
  "text": "儿子说爸,你能不能别老说这些"
 },
 {
  "start": 58.79,
  "end": 60.79,
  "text": "他说他当时就笑了一下"
 },
 {
  "start": 60.87,
  "end": 64.71,
  "text": "从此他在没在家里提起过单位的事情"
 },
 {
  "start": 64.71,
  "end": 66.51,
  "text": "你以为是你老婆不关心你"
 },
 {
  "start": 66.51,
  "end": 69.59,
  "text": "孩子不懂事,其实不全事"
 },
 {
  "start": 69.59,
  "end": 73.63,
  "text": "是一个家慢慢没了说话的位置"
 },
 {
  "start": 73.63,
  "end": 75.95,
  "text": "你想想,一家人都在"
 },
 {
  "start": 75.95,
  "end": 79.11,
  "text": "可每个人都在自己的屏上"
 },
 {
  "start": 79.11,
  "end": 81.51,
  "text": "你再说话,他们在听"
 },
 {
  "start": 81.51,
  "end": 82.67,
  "text": "当没在听"
 },
 {
  "start": 82.67,
  "end": 84.03,
  "text": "你也不用怪他们"
 },
 {
  "start": 84.03,
  "end": 85.67,
  "text": "因为轮到你停他的时候"
 },
 {
  "start": 85.67,
  "end": 87.51,
  "text": "你可能也在看手机"
 },
 {
  "start": 87.51,
  "end": 88.95,
  "text": "那怎么办呢"
 },
 {
  "start": 88.95,
  "end": 90.43,
  "text": "把话说短"
 },
 {
  "start": 90.47,
  "end": 92.83,
  "text": "说到有人能懂为止"
 },
 {
  "start": 92.83,
  "end": 93.79,
  "text": "不要说十分钟"
 },
 {
  "start": 93.79,
  "end": 94.95,
  "text": "你就说一句"
 },
 {
  "start": 94.95,
  "end": 97.47,
  "text": "今天有件事挺憋屈的"
 },
 {
  "start": 97.47,
  "end": 98.91,
  "text": "这句是个钩子"
 },
 {
  "start": 98.91,
  "end": 100.23,
  "text": "他要是问什么事"
 },
 {
  "start": 100.23,
  "end": 101.35,
  "text": "你在往下说"
 },
 {
  "start": 101.35,
  "end": 102.27,
  "text": "他要是不问"
 },
 {
  "start": 102.27,
  "end": 103.35,
  "text": "你就先不说"
 },
 {
  "start": 103.35,
  "end": 105.39,
  "text": "今天不是时候"
 },
 {
  "start": 105.39,
  "end": 108.27,
  "text": "第二件找一个固定的说话时间"
 },
 {
  "start": 108.27,
  "end": 109.03,
  "text": "比如吃完饭了"
 },
 {
  "start": 109.03,
  "end": 110.79,
  "text": "在十分钟手机放一边"
 },
 {
  "start": 110.79,
  "end": 114.27,
  "text": "哪怕只是聊今天的见到谁了"
 },
 {
  "start": 114.27,
  "end": 116.55,
  "text": "第三件先协会听他"
 },
 {
  "start": 116.55,
  "end": 118.63,
  "text": "他跟你说个事的时候"
 },
 {
  "start": 118.67,
  "end": 119.71,
  "text": "你放下手机"
 },
 {
  "start": 119.71,
  "end": 120.71,
  "text": "看他一眼"
 },
 {
  "start": 120.71,
  "end": 122.27,
  "text": "硬一声"
 },
 {
  "start": 122.27,
  "end": 123.95,
  "text": "你先接着他这一次"
 },
 {
  "start": 123.95,
  "end": 126.39,
  "text": "他才愿意接你一次"
 },
 {
  "start": 126.39,
  "end": 127.43,
  "text": "这是个来回"
 },
 {
  "start": 127.43,
  "end": 128.91,
  "text": "这是个互动"
 },
 {
  "start": 128.91,
  "end": 129.55,
  "text": "我跟你讲"
 },
 {
  "start": 129.55,
  "end": 131.99,
  "text": "中联男人巨大的孤独不是没人陪"
 },
 {
  "start": 131.99,
  "end": 133.75,
  "text": "是坐在一座人的中间"
 },
 {
  "start": 133.75,
  "end": 134.67,
  "text": "说了一句话"
 },
 {
  "start": 134.67,
  "end": 135.87,
  "text": "没有人接"
 },
 {
  "start": 135.87,
  "end": 137.75,
  "text": "这句话掉在地上"
 },
 {
  "start": 137.75,
  "end": 139.75,
  "text": "你听见他想了一声"
 },
 {
  "start": 141.51,
  "end": 142.95,
  "text": "所以不是没有人在"
 },
 {
  "start": 142.95,
  "end": 143.87,
  "text": "是没有人接"
 },
 {
  "start": 143.87,
  "end": 145.27,
  "text": "你先把手机放下"
 },
 {
  "start": 145.27,
  "end": 146.95,
  "text": "接他一次"
 },
 {
  "start": 146.99,
  "end": 147.87,
  "text": "别人去告诉我"
 },
 {
  "start": 147.87,
  "end": 148.87,
  "text": "你在家说话"
 },
 {
  "start": 148.87,
  "end": 149.87,
  "text": "一般"
 },
 {
  "start": 149.87,
  "end": 151.15,
  "text": "一有人接"
 },
 {
  "start": 151.15,
  "end": 152.91,
  "text": "二说两句就没人应了"
 },
 {
  "start": 152.91,
  "end": 154.99,
  "text": "三我干脆不说了"
 },
 {
  "start": 154.99,
  "end": 155.71,
  "text": "收查一下"
 },
 {
  "start": 155.71,
  "end": 156.43,
  "text": "今天晚上"
 },
 {
  "start": 156.43,
  "end": 157.31,
  "text": "先试一试"
 },
 {
  "start": 157.31,
  "end": 160.03,
  "text": "放下手机听他说10分钟"
 },
 {
  "start": 160.03,
  "end": 160.91,
  "text": "转给你老婆"
 },
 {
  "start": 160.91,
  "end": 161.63,
  "text": "不是够壮"
 },
 {
  "start": 161.63,
  "end": 164.11,
  "text": "是想让他知道你那句"
 },
 {
  "start": 164.11,
  "end": 165.51,
  "text": "我70一直在等"
 },
 {
  "start": 166.63,
  "end": 167.27,
  "text": "下一讲"
 },
 {
  "start": 167.27,
  "end": 168.83,
  "text": "我说个狠的"
 },
 {
  "start": 168.83,
  "end": 169.95,
  "text": "事实以后"
 },
 {
  "start": 169.95,
  "end": 172.79,
  "text": "你的朋友是怎么一个一个没的"
 }
]