[
 {
  "start": 0.62,
  "end": 3.86,
  "text": "孩子长大了,不再需要你了"
 },
 {
  "start": 3.86,
  "end": 7.74,
  "text": "他不再需要你的那一天,你才真的老了"
 },
 {
  "start": 7.74,
  "end": 10.82,
  "text": "你有没有过这样一下,他出门不跟你说"
 },
 {
  "start": 10.82,
  "end": 12.78,
  "text": "他自己买的东西不问你"
 },
 {
  "start": 12.78,
  "end": 15.74,
  "text": "他摔了跤,自己处理完,才告诉你"
 },
 {
  "start": 15.74,
  "end": 17.98,
  "text": "你心里那个滋味说不出来"
 },
 {
  "start": 17.98,
  "end": 21.1,
  "text": "不是难受,是我好像没用了"
 },
 {
  "start": 21.1,
  "end": 23.5,
  "text": "我认识一位妈妈,五十出头"
 },
 {
  "start": 23.5,
  "end": 26.1,
  "text": "儿子上大学,第一个学期回来"
 },
 {
  "start": 26.1,
  "end": 29.34,
  "text": "她做了一桌子菜,儿子吃了两口说"
 },
 {
  "start": 29.46,
  "end": 31.98,
  "text": "妈,我吃过了"
 },
 {
  "start": 31.98,
  "end": 34.9,
  "text": "她说她当时就笑了一下"
 },
 {
  "start": 34.9,
  "end": 36.78,
  "text": "那你吃水果吧"
 },
 {
  "start": 36.78,
  "end": 39.06,
  "text": "进了厨房眼泪就下来了"
 },
 {
  "start": 39.06,
  "end": 42.78,
  "text": "她说,我做的这桌菜好像白做了"
 },
 {
  "start": 42.78,
  "end": 45.54,
  "text": "你以为这是失落,是舍不得"
 },
 {
  "start": 45.54,
  "end": 46.78,
  "text": "其实不是"
 },
 {
  "start": 46.78,
  "end": 50.38,
  "text": "这叫角色空了,角色空了"
 },
 {
  "start": 50.38,
  "end": 51.9,
  "text": "你想想这二十年"
 },
 {
  "start": 51.9,
  "end": 54.5,
  "text": "你每天的头等大师是孩子"
 },
 {
  "start": 54.5,
  "end": 56.3,
  "text": "他吃饭,他上学"
 },
 {
  "start": 56.3,
  "end": 58.18,
  "text": "他生病,他口杂"
 },
 {
  "start": 58.18,
  "end": 61.22,
  "text": "他走了,你那个头等大师,没了"
 },
 {
  "start": 61.22,
  "end": 62.54,
  "text": "不是他不要你"
 },
 {
  "start": 62.54,
  "end": 65.78,
  "text": "是你还没找到,下一个你"
 },
 {
  "start": 65.78,
  "end": 67.5,
  "text": "那咋办呢"
 },
 {
  "start": 67.5,
  "end": 69.14,
  "text": "别急着重新上岗"
 },
 {
  "start": 69.14,
  "end": 70.74,
  "text": "有的人孩子一走"
 },
 {
  "start": 70.74,
  "end": 73.46,
  "text": "就天天打电话,天天送东西"
 },
 {
  "start": 73.46,
  "end": 74.7,
  "text": "不是孩子烦"
 },
 {
  "start": 74.7,
  "end": 77.58,
  "text": "是他在学着自己活"
 },
 {
  "start": 77.58,
  "end": 80.42,
  "text": "你也要学着自己去活"
 },
 {
  "start": 80.42,
  "end": 81.3,
  "text": "然后第二件呢"
 },
 {
  "start": 81.3,
  "end": 85.38,
  "text": "我们也可以给自己去找一件要花心事的事情"
 },
 {
  "start": 85.38,
  "end": 88.58,
  "text": "不是打发时间是真的要认真干起来"
 },
 {
  "start": 88.58,
  "end": 92.18,
  "text": "比如我们要种菜,养花,学个手艺"
 },
 {
  "start": 92.18,
  "end": 94.42,
  "text": "或者去社区帮忙"
 },
 {
  "start": 94.42,
  "end": 98.5,
  "text": "有一件事你就不会感觉自己很空"
 },
 {
  "start": 98.5,
  "end": 99.1,
  "text": "第三件呢"
 },
 {
  "start": 99.1,
  "end": 101.62,
  "text": "我们也可以换个身份跟他相处"
 },
 {
  "start": 101.62,
  "end": 103.06,
  "text": "从管他的妈"
 },
 {
  "start": 103.06,
  "end": 106.26,
  "text": "变成能跟他聊天的妈"
 },
 {
  "start": 106.26,
  "end": 108.7,
  "text": "他不再需要你给他做饭"
 },
 {
  "start": 108.7,
  "end": 110.42,
  "text": "他需要你懂他"
 },
 {
  "start": 110.42,
  "end": 112.78,
  "text": "还能跟他说的上话"
 },
 {
  "start": 112.78,
  "end": 115.54,
  "text": "我跟你讲孩子长大是好事"
 },
 {
  "start": 115.54,
  "end": 118.86,
  "text": "你别把他过程我被抛弃了"
 },
 {
  "start": 118.86,
  "end": 120.58,
  "text": "你把他犯出去"
 },
 {
  "start": 120.58,
  "end": 122.74,
  "text": "然后你回头看看你自己"
 },
 {
  "start": 122.74,
  "end": 125.42,
  "text": "因为你还有下半辈子"
 },
 {
  "start": 125.42,
  "end": 126.86,
  "text": "他不是不要你了"
 },
 {
  "start": 126.86,
  "end": 128.26,
  "text": "是他长大了"
 },
 {
  "start": 128.26,
  "end": 130.7,
  "text": "那你也该长大了"
 },
 {
  "start": 130.7,
  "end": 131.9,
  "text": "评论区改个数字"
 },
 {
  "start": 131.9,
  "end": 134.14,
  "text": "孩子现在是在你的身边"
 },
 {
  "start": 134.14,
  "end": 135.74,
  "text": "还是天天在你眼前"
 },
 {
  "start": 135.74,
  "end": 137.62,
  "text": "或者是上大学在外地"
 },
 {
  "start": 137.62,
  "end": 139.5,
  "text": "或者是已经成家了"
 },
 {
  "start": 139.5,
  "end": 140.1,
  "text": "对吧"
 },
 {
  "start": 140.1,
  "end": 142.58,
  "text": "把自己这条把我们这条月收藏起来"
 },
 {
  "start": 142.58,
  "end": 144.58,
  "text": "当自己看不到小孩燃烧的时候"
 },
 {
  "start": 144.58,
  "end": 145.98,
  "text": "也可以拿出来看一看"
 },
 {
  "start": 145.98,
  "end": 149.78,
  "text": "然后找一件花心思的事给自己做"
 },
 {
  "start": 149.78,
  "end": 152.38,
  "text": "转给你那个空潮气的老姐妹"
 },
 {
  "start": 152.38,
  "end": 155.9,
  "text": "他需要有人陪伴他找过这一段路"
 },
 {
  "start": 155.9,
  "end": 159.1,
  "text": "下来讲我们讲一讲那些到家了"
 },
 {
  "start": 159.1,
  "end": 160.66,
  "text": "还不想下车的人"
 }
]