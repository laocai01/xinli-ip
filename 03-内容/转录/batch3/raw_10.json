[
 {
  "start": 0.43,
  "end": 3.43,
  "text": "你一回家就想在车里做一伙"
 },
 {
  "start": 3.43,
  "end": 5.43,
  "text": "到了不想下车"
 },
 {
  "start": 5.43,
  "end": 6.43,
  "text": "不是你不爱这个家"
 },
 {
  "start": 6.43,
  "end": 8.43,
  "text": "是你需要缓一缓"
 },
 {
  "start": 9.43,
  "end": 10.43,
  "text": "对不对"
 },
 {
  "start": 11.43,
  "end": 13.43,
  "text": "回到家里停车场"
 },
 {
  "start": 13.43,
  "end": 15.43,
  "text": "在车里抽烟"
 },
 {
  "start": 15.43,
  "end": 17.43,
  "text": "或者在家里做一做听听音乐"
 },
 {
  "start": 17.43,
  "end": 19.43,
  "text": "这个是我们中联老灯"
 },
 {
  "start": 19.43,
  "end": 22.43,
  "text": "还有中联这个联系的"
 },
 {
  "start": 22.43,
  "end": 23.43,
  "text": "家里的父母"
 },
 {
  "start": 23.43,
  "end": 24.43,
  "text": "比较经常做的一件事情"
 },
 {
  "start": 24.43,
  "end": 26.43,
  "text": "包括我自己也是一样"
 },
 {
  "start": 26.43,
  "end": 28.43,
  "text": "每次一到小区"
 },
 {
  "start": 28.43,
  "end": 29.43,
  "text": "我都会停下来"
 },
 {
  "start": 29.43,
  "end": 30.43,
  "text": "在车里抽个烟"
 },
 {
  "start": 30.43,
  "end": 32.43,
  "text": "或者是听听音乐"
 },
 {
  "start": 32.43,
  "end": 33.43,
  "text": "看看刷刷手机"
 },
 {
  "start": 33.43,
  "end": 35.43,
  "text": "然后我才会回到家里"
 },
 {
  "start": 35.43,
  "end": 36.43,
  "text": "对不对"
 },
 {
  "start": 37.43,
  "end": 39.43,
  "text": "现在开始"
 },
 {
  "start": 39.43,
  "end": 41.43,
  "text": "你在车里做多久"
 },
 {
  "start": 41.43,
  "end": 42.43,
  "text": "五分钟 十分钟"
 },
 {
  "start": 42.43,
  "end": 43.43,
  "text": "有时候点了一个烟"
 },
 {
  "start": 43.43,
  "end": 44.43,
  "text": "有时候啥也不干"
 },
 {
  "start": 44.43,
  "end": 45.43,
  "text": "听一首歌"
 },
 {
  "start": 45.43,
  "end": 47.43,
  "text": "楼道里的灯是亮的"
 },
 {
  "start": 47.43,
  "end": 49.43,
  "text": "你家里的饭也是热的"
 },
 {
  "start": 49.43,
  "end": 51.43,
  "text": "可就是不想"
 },
 {
  "start": 51.43,
  "end": 53.43,
  "text": "推开那一扇门"
 },
 {
  "start": 53.43,
  "end": 54.43,
  "text": "你有没有想过"
 },
 {
  "start": 54.43,
  "end": 55.43,
  "text": "你在车里干过什么"
 },
 {
  "start": 55.43,
  "end": 56.43,
  "text": "不是休息"
 },
 {
  "start": 56.43,
  "end": 58.43,
  "text": "你是在换人"
 },
 {
  "start": 58.43,
  "end": 60.43,
  "text": "外面那个你是员工"
 },
 {
  "start": 60.43,
  "end": 61.43,
  "text": "是老板"
 },
 {
  "start": 61.43,
  "end": 63.43,
  "text": "是别人有你的某某某"
 },
 {
  "start": 63.43,
  "end": 65.43,
  "text": "家里那个你是老公"
 },
 {
  "start": 65.43,
  "end": 66.43,
  "text": "是爸爸"
 },
 {
  "start": 66.43,
  "end": 67.43,
  "text": "是妈妈"
 },
 {
  "start": 67.43,
  "end": 69.43,
  "text": "是那个不能垮的人"
 },
 {
  "start": 69.43,
  "end": 71.43,
  "text": "车里那十分钟"
 },
 {
  "start": 71.43,
  "end": 72.43,
  "text": "是你唯一一个"
 },
 {
  "start": 72.43,
  "end": 74.43,
  "text": "谁都不是的时候"
 },
 {
  "start": 74.43,
  "end": 76.43,
  "text": "我认识一个老哥"
 },
 {
  "start": 76.43,
  "end": 78.43,
  "text": "跑销售的"
 },
 {
  "start": 78.43,
  "end": 79.43,
  "text": "他说他每天"
 },
 {
  "start": 79.43,
  "end": 80.43,
  "text": "最舒服的十分钟"
 },
 {
  "start": 80.43,
  "end": 82.43,
  "text": "就是在车里"
 },
 {
  "start": 82.43,
  "end": 84.43,
  "text": "有一回他老婆下楼丢垃圾"
 },
 {
  "start": 84.43,
  "end": 85.43,
  "text": "看见他就在车里"
 },
 {
  "start": 85.43,
  "end": 86.43,
  "text": "一动不动"
 },
 {
  "start": 86.43,
  "end": 87.43,
  "text": "回去就吵了一架"
 },
 {
  "start": 87.43,
  "end": 89.43,
  "text": "说你是不是不想回家"
 },
 {
  "start": 89.43,
  "end": 91.43,
  "text": "他说我不是不想回家"
 },
 {
  "start": 91.43,
  "end": 92.43,
  "text": "我是不知道"
 },
 {
  "start": 92.43,
  "end": 94.43,
  "text": "怎么从那个人"
 },
 {
  "start": 94.43,
  "end": 96.43,
  "text": "变成这一个人"
 },
 {
  "start": 96.43,
  "end": 97.43,
  "text": "你以为"
 },
 {
  "start": 97.43,
  "end": 98.43,
  "text": "这说明你对他"
 },
 {
  "start": 98.43,
  "end": 100.43,
  "text": "对这个家都没感情了吗"
 },
 {
  "start": 100.43,
  "end": 101.43,
  "text": "那肯定不是"
 },
 {
  "start": 101.43,
  "end": 102.43,
  "text": "说明你这几年"
 },
 {
  "start": 102.43,
  "end": 104.43,
  "text": "这十年一直在硬撑"
 },
 {
  "start": 104.43,
  "end": 105.43,
  "text": "你想想"
 },
 {
  "start": 105.43,
  "end": 107.43,
  "text": "你上班要撑"
 },
 {
  "start": 107.43,
  "end": 108.43,
  "text": "回家要撑"
 },
 {
  "start": 108.43,
  "end": 110.43,
  "text": "父母那边要撑"
 },
 {
  "start": 110.43,
  "end": 112.43,
  "text": "你不是需要那十分钟"
 },
 {
  "start": 112.43,
  "end": 115.43,
  "text": "你是需要一天你"
 },
 {
  "start": 115.43,
  "end": 116.43,
  "text": "有一段的时间"
 },
 {
  "start": 116.43,
  "end": 119.43,
  "text": "没有人需要你"
 },
 {
  "start": 119.43,
  "end": 121.43,
  "text": "虽然说那只有十分钟"
 },
 {
  "start": 121.43,
  "end": 123.43,
  "text": "但是那十分钟"
 },
 {
  "start": 123.43,
  "end": 125.43,
  "text": "里面需要你的感觉"
 },
 {
  "start": 125.43,
  "end": 127.43,
  "text": "你自己才懂"
 },
 {
  "start": 127.43,
  "end": 128.43,
  "text": "那怎么办呢"
 },
 {
  "start": 128.43,
  "end": 131.43,
  "text": "把那十分钟变成一个规矩"
 },
 {
  "start": 131.43,
  "end": 132.43,
  "text": "回家前"
 },
 {
  "start": 132.43,
  "end": 134.43,
  "text": "你在车里坐五分钟"
 },
 {
  "start": 134.43,
  "end": 135.43,
  "text": "这不是偷偷摸摸"
 },
 {
  "start": 135.43,
  "end": 137.43,
  "text": "你可以跟家里说清楚"
 },
 {
  "start": 137.43,
  "end": 139.43,
  "text": "我在车里坐五分钟"
 },
 {
  "start": 139.43,
  "end": 140.43,
  "text": "缓一缓"
 },
 {
  "start": 140.43,
  "end": 141.43,
  "text": "不是生气"
 },
 {
  "start": 141.43,
  "end": 142.43,
  "text": "别等我"
 },
 {
  "start": 142.43,
  "end": 144.43,
  "text": "你说清楚了"
 },
 {
  "start": 144.43,
  "end": 145.43,
  "text": "他就不会多想"
 },
 {
  "start": 145.43,
  "end": 147.43,
  "text": "你不说他才会觉得"
 },
 {
  "start": 147.43,
  "end": 148.43,
  "text": "你不对劲"
 },
 {
  "start": 148.43,
  "end": 149.43,
  "text": "才会胡思乱想"
 },
 {
  "start": 149.43,
  "end": 150.43,
  "text": "第二件"
 },
 {
  "start": 150.43,
  "end": 151.43,
  "text": "进门以后"
 },
 {
  "start": 151.43,
  "end": 153.43,
  "text": "别说今天累死了"
 },
 {
  "start": 153.43,
  "end": 154.43,
  "text": "说一句具体的"
 },
 {
  "start": 154.43,
  "end": 156.43,
  "text": "今天被客户骂了一下"
 },
 {
  "start": 156.43,
  "end": 157.43,
  "text": "也摸了一下午"
 },
 {
  "start": 157.43,
  "end": 158.43,
  "text": "比较烦"
 },
 {
  "start": 158.43,
  "end": 159.43,
  "text": "具体的累"
 },
 {
  "start": 159.43,
  "end": 160.43,
  "text": "他才能记得住"
 },
 {
  "start": 160.43,
  "end": 161.43,
  "text": "你只说累"
 },
 {
  "start": 161.43,
  "end": 162.43,
  "text": "他只能回"
 },
 {
  "start": 162.43,
  "end": 163.43,
  "text": "谁不累啊"
 },
 {
  "start": 163.43,
  "end": 164.43,
  "text": "好像住里的累一样"
 },
 {
  "start": 164.43,
  "end": 165.43,
  "text": "我不上班"
 },
 {
  "start": 165.43,
  "end": 166.43,
  "text": "我也累啊"
 },
 {
  "start": 166.43,
  "end": 167.43,
  "text": "我现在干家务"
 },
 {
  "start": 167.43,
  "end": 168.43,
  "text": "带小孩我也累啊"
 },
 {
  "start": 168.43,
  "end": 169.43,
  "text": "对不对"
 },
 {
  "start": 169.43,
  "end": 170.43,
  "text": "所以一定要把那个累"
 },
 {
  "start": 170.43,
  "end": 172.43,
  "text": "说得更具体一些"
 },
 {
  "start": 172.43,
  "end": 173.43,
  "text": "我跟你讲"
 },
 {
  "start": 173.43,
  "end": 174.43,
  "text": "就是车里那十分钟"
 },
 {
  "start": 174.43,
  "end": 175.43,
  "text": "不是逃避啊"
 },
 {
  "start": 175.43,
  "end": 176.43,
  "text": "不是逃避"
 },
 {
  "start": 176.43,
  "end": 177.43,
  "text": "是一个人给自己"
 },
 {
  "start": 177.43,
  "end": 179.43,
  "text": "留了一口气"
 },
 {
  "start": 179.43,
  "end": 181.43,
  "text": "有这一口气的人"
 },
 {
  "start": 181.43,
  "end": 183.43,
  "text": "回家才笑得出来"
 },
 {
  "start": 183.43,
  "end": 185.43,
  "text": "所以你不是不想回家"
 },
 {
  "start": 185.43,
  "end": 187.43,
  "text": "你只是需要一点时间"
 },
 {
  "start": 187.43,
  "end": 189.43,
  "text": "把自己从外面那个"
 },
 {
  "start": 189.43,
  "end": 191.43,
  "text": "变回家里那个"
 },
 {
  "start": 191.43,
  "end": 192.43,
  "text": "评论区跟我说"
 },
 {
  "start": 192.43,
  "end": 194.43,
  "text": "你在家里"
 },
 {
  "start": 194.43,
  "end": 195.43,
  "text": "在回家时候"
 },
 {
  "start": 195.43,
  "end": 197.43,
  "text": "在车里坐过吗"
 },
 {
  "start": 197.43,
  "end": 198.43,
  "text": "天天坐"
 },
 {
  "start": 198.43,
  "end": 199.43,
  "text": "或者是没坐过"
 },
 {
  "start": 199.43,
  "end": 201.43,
  "text": "但我在楼下抽个烟"
 },
 {
  "start": 202.43,
  "end": 204.43,
  "text": "这条收藏起来"
 },
 {
  "start": 204.43,
  "end": 205.43,
  "text": "也转给老婆看看"
 },
 {
  "start": 205.43,
  "end": 206.43,
  "text": "她不是起心"
 },
 {
  "start": 206.43,
  "end": 208.43,
  "text": "也是不知道你怎么了"
 },
 {
  "start": 208.43,
  "end": 209.43,
  "text": "她才会怀疑"
 },
 {
  "start": 209.43,
  "end": 210.43,
  "text": "所以转给她的时候"
 },
 {
  "start": 210.43,
  "end": 211.43,
  "text": "可以说一句"
 },
 {
  "start": 211.43,
  "end": 212.43,
  "text": "我就是坐一坐"
 },
 {
  "start": 212.43,
  "end": 213.43,
  "text": "坐一坐"
 },
 {
  "start": 213.43,
  "end": 214.43,
  "text": "缓一缓"
 },
 {
  "start": 214.43,
  "end": 216.43,
  "text": "不是不想回家"
 },
 {
  "start": 216.43,
  "end": 217.43,
  "text": "下一讲"
 },
 {
  "start": 217.43,
  "end": 219.43,
  "text": "说说你在家说话"
 },
 {
  "start": 219.43,
  "end": 220.43,
  "text": "为什么说了商具"
 },
 {
  "start": 220.43,
  "end": 222.43,
  "text": "就没有人接了"
 }
]