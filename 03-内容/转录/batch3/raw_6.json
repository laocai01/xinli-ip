[
 {
  "start": 0.4,
  "end": 4.92,
  "text": "当妈的,最怕被说的是你在家能有多累"
 },
 {
  "start": 5.32,
  "end": 9.08,
  "text": "你在家带一天的孩子,比上班还累"
 },
 {
  "start": 9.08,
  "end": 12.88,
  "text": "可没人给你发工资,也没人给你下班"
 },
 {
  "start": 13.24,
  "end": 17.24,
  "text": "你有没有听过这句话,你在家能有多累"
 },
 {
  "start": 17.4,
  "end": 22.12,
  "text": "说这话的,可能是你老公,可能是你婆婆"
 },
 {
  "start": 22.12,
  "end": 24.12,
  "text": "也可能是你自己"
 },
 {
  "start": 24.12,
  "end": 27.6,
  "text": "累到几点,还觉得自己矫情"
 },
 {
  "start": 28.52,
  "end": 33.72,
  "text": "最后这句三人,别人说你,你还能气得跳起来"
 },
 {
  "start": 33.72,
  "end": 37.64,
  "text": "你自己说自己,你连气都气不起来"
 },
 {
  "start": 37.64,
  "end": 41.04,
  "text": "我认识一位全职妈妈,她还这两岁"
 },
 {
  "start": 41.04,
  "end": 44.6,
  "text": "在家,她怎么说的"
 },
 {
  "start": 44.6,
  "end": 46.6,
  "text": "她说她去崩溃的一次"
 },
 {
  "start": 46.6,
  "end": 50.6,
  "text": "是孩子把一碗粥扣在她的头上"
 },
 {
  "start": 50.6,
  "end": 53.6,
  "text": "她蹲在地上插地板"
 },
 {
  "start": 53.6,
  "end": 56.0,
  "text": "插着插着,突然停了"
 },
 {
  "start": 56.0,
  "end": 59.72,
  "text": "她说,我不是难过,孩子调皮"
 },
 {
  "start": 59.72,
  "end": 61.72,
  "text": "我是突然想起来"
 },
 {
  "start": 61.72,
  "end": 66.2,
  "text": "我从早上睁夜,一句大人的话都没说过"
 },
 {
  "start": 66.2,
  "end": 69.8,
  "text": "你以为累是因为活太多了"
 },
 {
  "start": 69.8,
  "end": 73.2,
  "text": "其实不是,在家带孩子是最累的"
 },
 {
  "start": 73.2,
  "end": 76.2,
  "text": "不是体力上的累,是没有下班"
 },
 {
  "start": 76.2,
  "end": 78.2,
  "text": "上班的人有个点"
 },
 {
  "start": 78.2,
  "end": 81.6,
  "text": "到点下班,出了门就不是工作"
 },
 {
  "start": 81.6,
  "end": 85.12,
  "text": "你呢,你半夜起来喂奶,那是上班"
 },
 {
  "start": 85.12,
  "end": 88.52,
  "text": "你早上起来做早饭,那是上班"
 },
 {
  "start": 88.52,
  "end": 91.72,
  "text": "她哭,你不睡,她睡,你不敢睡"
 },
 {
  "start": 91.72,
  "end": 96.52,
  "text": "二十四小时,没有一个点觉,我下班了"
 },
 {
  "start": 96.52,
  "end": 99.32,
  "text": "还有一个更累的,你干了这些"
 },
 {
  "start": 99.32,
  "end": 102.32,
  "text": "没人给你提供,一年干了下来"
 },
 {
  "start": 102.32,
  "end": 106.32,
  "text": "你在旅游上写着四个字,待夜在家"
 },
 {
  "start": 106.32,
  "end": 109.32,
  "text": "那怎么办呢?三句话,说给你自己听"
 },
 {
  "start": 109.32,
  "end": 113.12,
  "text": "第一句,我干的是一份工作,不是在玩"
 },
 {
  "start": 113.12,
  "end": 116.12,
  "text": "你可以在家里明确的说一件事"
 },
 {
  "start": 116.12,
  "end": 119.12,
  "text": "我白天带孩子,这是长点的分工"
 },
 {
  "start": 119.12,
  "end": 123.12,
  "text": "我白天带孩子,把帮忙这两个字"
 },
 {
  "start": 123.12,
  "end": 125.12,
  "text": "从你脑子里删掉"
 },
 {
  "start": 125.12,
  "end": 128.12,
  "text": "他带孩子不是帮忙,那也是他的活"
 },
 {
  "start": 128.12,
  "end": 132.12,
  "text": "第二句,我每天要有一小时不是妈妈"
 },
 {
  "start": 132.12,
  "end": 135.12,
  "text": "一小时不算多,出去走一走"
 },
 {
  "start": 135.12,
  "end": 138.12,
  "text": "或者睡一个觉,什么都不用干"
 },
 {
  "start": 138.12,
  "end": 141.12,
  "text": "这一个小时不是奖励,是必须的"
 },
 {
  "start": 141.12,
  "end": 145.12,
  "text": "第三句,我累了,那我要说出来"
 },
 {
  "start": 145.12,
  "end": 148.12,
  "text": "别说我没事,你也说没事"
 },
 {
  "start": 148.12,
  "end": 151.12,
  "text": "他又以为你真的没事,我跟你讲"
 },
 {
  "start": 151.12,
  "end": 154.12,
  "text": "你把自己熬垮了,没有人会夸你"
 },
 {
  "start": 154.12,
  "end": 157.12,
  "text": "孩子需要的是一个还活着的妈妈"
 },
 {
  "start": 157.12,
  "end": 159.12,
  "text": "不是一个完美的妈妈"
 },
 {
  "start": 159.12,
  "end": 161.12,
  "text": "说到底还是一句话"
 },
 {
  "start": 161.12,
  "end": 164.12,
  "text": "你不是在家闲着,你是在干一份"
 },
 {
  "start": 164.12,
  "end": 167.12,
  "text": "没有下班,没有工资的活"
 },
 {
  "start": 167.12,
  "end": 171.12,
  "text": "别人去打个数字,你是一拳直带娃"
 },
 {
  "start": 171.12,
  "end": 174.12,
  "text": "二上班又带娃,三带孙子"
 },
 {
  "start": 174.12,
  "end": 177.12,
  "text": "我看看有多少人跟你一样"
 },
 {
  "start": 177.12,
  "end": 179.12,
  "text": "或者跟我们一样吧"
 },
 {
  "start": 179.12,
  "end": 182.12,
  "text": "这条你收藏着,哪天被人说你在家"
 },
 {
  "start": 182.12,
  "end": 185.12,
  "text": "能有多累,你就翻出来看一看"
 },
 {
  "start": 185.12,
  "end": 188.12,
  "text": "你没有矫情,转给你老公"
 },
 {
  "start": 188.12,
  "end": 190.12,
  "text": "你不是骂他,是让他看看"
 },
 {
  "start": 190.12,
  "end": 193.12,
  "text": "你那一天到底是怎么过的"
 },
 {
  "start": 193.12,
  "end": 196.12,
  "text": "下一讲,我说个特别小的事"
 },
 {
  "start": 196.12,
  "end": 199.12,
  "text": "多久没给自己买过一样东西"
 }
]