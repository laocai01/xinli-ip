[
 {
  "start": 0.3,
  "end": 4.1,
  "text": "你天天管孩子,那你自己呢?"
 },
 {
  "start": 4.1,
  "end": 9.3,
  "text": "你把力气都给了孩子,那你自己那一口气谁来接?"
 },
 {
  "start": 9.3,
  "end": 14.3,
  "text": "咱们先不说孩子,说说你,你今天早上几点钟起床的,"
 },
 {
  "start": 14.3,
  "end": 18.3,
  "text": "你给孩子做个早饭没有,你自己又吃了没有?"
 },
 {
  "start": 18.3,
  "end": 22.3,
  "text": "你送完他上学,回来路上,你又在想什么?"
 },
 {
  "start": 22.3,
  "end": 25.3,
  "text": "想的是今天还有什么事没干?"
 },
 {
  "start": 25.3,
  "end": 29.3,
  "text": "你有没有哪怕一分钟,想的是我累不累?"
 },
 {
  "start": 29.3,
  "end": 34.3,
  "text": "我认识一位妈妈,她跟我说,她去放松的时候是在车里,"
 },
 {
  "start": 34.3,
  "end": 39.3,
  "text": "停好了车以后不上楼,在车里坐十分钟,"
 },
 {
  "start": 39.3,
  "end": 43.3,
  "text": "我问她这十分钟她在干什么?她说她啥也不干,"
 },
 {
  "start": 43.3,
  "end": 49.3,
  "text": "就没有人叫我妈,你听这句话,心里是什么滋味?"
 },
 {
  "start": 49.3,
  "end": 53.3,
  "text": "你以为当爸妈就该这样?其实不是,"
 },
 {
  "start": 54.3,
  "end": 60.3,
  "text": "这叫把自己活没了,你是看,你现在想一件事都能想半天,"
 },
 {
  "start": 60.3,
  "end": 65.3,
  "text": "我上一次给自己买一件东西是什么时候了?想不起来了吧?"
 },
 {
  "start": 65.3,
  "end": 69.3,
  "text": "不是你记性差,是你这几年压根没把自己列进,"
 },
 {
  "start": 69.3,
  "end": 73.3,
  "text": "购买或者是放开自己的名单里,那怎么办呢?"
 },
 {
  "start": 73.3,
  "end": 76.3,
  "text": "就做三件小事,从今天开始第一件,"
 },
 {
  "start": 76.3,
  "end": 80.3,
  "text": "每天给自己十分钟,十分钟不给小孩,"
 },
 {
  "start": 80.3,
  "end": 85.3,
  "text": "不给家里,给你自己,坐着,或者走一圈,"
 },
 {
  "start": 85.3,
  "end": 88.3,
  "text": "这十分钟不是浪费,是给自己充电,"
 },
 {
  "start": 88.3,
  "end": 92.3,
  "text": "第二件,给自己买一件东西,不用贵,"
 },
 {
  "start": 92.3,
  "end": 96.3,
  "text": "一支笔也好,一双袜子也好,一杯来茶也好,"
 },
 {
  "start": 96.3,
  "end": 100.3,
  "text": "只要是你给自己花钱,这不是自私,是告诉自己,"
 },
 {
  "start": 100.3,
  "end": 106.3,
  "text": "我也算个人,第三件,找一个人说一句真话,"
 },
 {
  "start": 106.3,
  "end": 111.3,
  "text": "不说我挺好的,说一句我最近有点累,"
 },
 {
  "start": 111.3,
  "end": 115.3,
  "text": "这一句很多人一辈子都没说过,"
 },
 {
  "start": 115.3,
  "end": 121.3,
  "text": "我跟你讲,一个把自己压根的爸妈"
 },
 {
  "start": 121.3,
  "end": 125.3,
  "text": "交不出一个心里有劲的孩子,"
 },
 {
  "start": 125.3,
  "end": 128.3,
  "text": "你要先活过来,然后呢,"
 },
 {
  "start": 128.3,
  "end": 133.3,
  "text": "孩子在旁边看着他才会学会怎么活,"
 },
 {
  "start": 133.3,
  "end": 137.3,
  "text": "说到底也还是一句话,你把自己活没了,"
 },
 {
  "start": 137.3,
  "end": 142.3,
  "text": "孩子也学不会怎么活,别论区打个数字,"
 },
 {
  "start": 142.3,
  "end": 146.3,
  "text": "你上一次给自己买东西是一半年前,"
 },
 {
  "start": 146.3,
  "end": 150.3,
  "text": "二一年前,三想不起来了,"
 },
 {
  "start": 150.3,
  "end": 154.3,
  "text": "这条你收藏着,今天晚上就给自己留那十分钟,"
 },
 {
  "start": 154.3,
  "end": 158.3,
  "text": "转给那个总是在位全家蛮的人,"
 },
 {
  "start": 158.3,
  "end": 161.3,
  "text": "不用说什么,转过去他会懂,"
 },
 {
  "start": 161.3,
  "end": 166.3,
  "text": "下一讲,我说说他妈的最怕听见的是哪一句话,"
 },
 {
  "start": 166.3,
  "end": 169.3,
  "text": "你在家能有多累?"
 }
]