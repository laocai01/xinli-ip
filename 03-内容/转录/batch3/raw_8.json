[
 {
  "start": 0.46,
  "end": 3.46,
  "text": "那个总说,我没事的,妈妈"
 },
 {
  "start": 3.46,
  "end": 6.46,
  "text": "家里谁病了,你最先知道"
 },
 {
  "start": 6.46,
  "end": 9.46,
  "text": "你自己生病了,你最后才知道"
 },
 {
  "start": 9.46,
  "end": 11.46,
  "text": "你有没有这样的时候呢?"
 },
 {
  "start": 11.46,
  "end": 14.46,
  "text": "孩子可以生,你马上就摸耳头"
 },
 {
  "start": 14.46,
  "end": 17.46,
  "text": "找药,量体温,老公说头疼"
 },
 {
  "start": 17.46,
  "end": 19.46,
  "text": "你立刻去买药,倒水"
 },
 {
  "start": 19.46,
  "end": 23.46,
  "text": "轮到你自己头晕,心慌,腰疼,睡不着"
 },
 {
  "start": 23.46,
  "end": 26.46,
  "text": "你说没事,可能是没休息好"
 },
 {
  "start": 26.46,
  "end": 27.46,
  "text": "然后就过去了"
 },
 {
  "start": 27.46,
  "end": 29.46,
  "text": "我认识一位阿姨,60岁"
 },
 {
  "start": 29.46,
  "end": 32.46,
  "text": "她住院那一天,是邻居送她去的"
 },
 {
  "start": 32.46,
  "end": 34.46,
  "text": "她儿子在外地,打电话过来"
 },
 {
  "start": 34.46,
  "end": 37.46,
  "text": "第一句话是,妈,你怎么不早说"
 },
 {
  "start": 37.46,
  "end": 41.46,
  "text": "她说了一句话,我在旁边听着心里发慌"
 },
 {
  "start": 41.46,
  "end": 43.46,
  "text": "她说,我怕你们担心"
 },
 {
  "start": 43.46,
  "end": 45.46,
  "text": "她怕孩子担心"
 },
 {
  "start": 45.46,
  "end": 47.46,
  "text": "怕老棒担心"
 },
 {
  "start": 47.46,
  "end": 49.46,
  "text": "怕麻烦任何人"
 },
 {
  "start": 49.46,
  "end": 51.46,
  "text": "结果呢,她一个人把事"
 },
 {
  "start": 51.46,
  "end": 53.46,
  "text": "砍到医院里去了"
 },
 {
  "start": 53.46,
  "end": 55.46,
  "text": "你以为这叫坚强"
 },
 {
  "start": 55.46,
  "end": 57.46,
  "text": "其实不是"
 },
 {
  "start": 57.46,
  "end": 59.46,
  "text": "这叫报喜不报忧"
 },
 {
  "start": 59.46,
  "end": 61.46,
  "text": "你在家学会了一件事"
 },
 {
  "start": 61.46,
  "end": 63.46,
  "text": "难道要长起来"
 },
 {
  "start": 63.46,
  "end": 65.46,
  "text": "因为你小时候一哭"
 },
 {
  "start": 65.46,
  "end": 67.46,
  "text": "大人就说,哭什么哭"
 },
 {
  "start": 67.46,
  "end": 68.46,
  "text": "对不对"
 },
 {
  "start": 68.46,
  "end": 69.46,
  "text": "于是你长大了"
 },
 {
  "start": 69.46,
  "end": 72.46,
  "text": "成了那个谁都不麻烦的人"
 },
 {
  "start": 72.46,
  "end": 74.46,
  "text": "可你又没有想过"
 },
 {
  "start": 74.46,
  "end": 76.46,
  "text": "你越是这样,家里越不知道"
 },
 {
  "start": 76.46,
  "end": 78.46,
  "text": "你需要什么"
 },
 {
  "start": 78.46,
  "end": 80.46,
  "text": "那怎么办呢"
 },
 {
  "start": 80.46,
  "end": 82.46,
  "text": "我们要学会说三句话"
 },
 {
  "start": 82.46,
  "end": 84.46,
  "text": "第一句,我今天不太舒服"
 },
 {
  "start": 84.46,
  "end": 86.46,
  "text": "就这一句,不用解释"
 },
 {
  "start": 86.46,
  "end": 88.46,
  "text": "不用加,当事没事"
 },
 {
  "start": 88.46,
  "end": 91.46,
  "text": "你说出来,别人才知道你难受"
 },
 {
  "start": 91.46,
  "end": 95.46,
  "text": "第二句,你能帮我一下这个吗"
 },
 {
  "start": 96.46,
  "end": 98.46,
  "text": "具体到一件事情"
 },
 {
  "start": 98.46,
  "end": 99.46,
  "text": "帮我买合药"
 },
 {
  "start": 99.46,
  "end": 101.46,
  "text": "帮我把碗洗了"
 },
 {
  "start": 101.46,
  "end": 104.46,
  "text": "越具体,别人越容易帮你"
 },
 {
  "start": 104.46,
  "end": 106.46,
  "text": "越容易懂你"
 },
 {
  "start": 106.46,
  "end": 109.46,
  "text": "不要只说,我很累"
 },
 {
  "start": 109.46,
  "end": 111.46,
  "text": "因为他不知道你该干嘛"
 },
 {
  "start": 111.46,
  "end": 115.46,
  "text": "第三句,我想让你陪我一会儿"
 },
 {
  "start": 115.46,
  "end": 117.46,
  "text": "这句话,句难说"
 },
 {
  "start": 117.46,
  "end": 120.46,
  "text": "可这句话,是人跟人之间"
 },
 {
  "start": 120.46,
  "end": 122.46,
  "text": "最需要的一句话"
 },
 {
  "start": 122.46,
  "end": 124.46,
  "text": "我跟你讲,一家人"
 },
 {
  "start": 124.46,
  "end": 127.46,
  "text": "不是靠谁扛的最多"
 },
 {
  "start": 127.46,
  "end": 130.46,
  "text": "是靠谁敢说,我不行了"
 },
 {
  "start": 130.46,
  "end": 133.46,
  "text": "你敢说,他们才知道"
 },
 {
  "start": 133.46,
  "end": 135.46,
  "text": "该往哪儿使劲"
 },
 {
  "start": 135.46,
  "end": 137.46,
  "text": "往哪儿去帮你"
 },
 {
  "start": 137.46,
  "end": 141.0,
  "text": "说到底还是那句话"
 },
 {
  "start": 141.0,
  "end": 142.0,
  "text": "你不说,不是体贴"
 },
 {
  "start": 142.0,
  "end": 144.0,
  "text": "事实上家里人永远不知道"
 },
 {
  "start": 144.0,
  "end": 146.0,
  "text": "怎么去爱你"
 },
 {
  "start": 146.0,
  "end": 147.0,
  "text": "评论区打个数字"
 },
 {
  "start": 147.0,
  "end": 150.0,
  "text": "你上次跟家人说,我不舒服"
 },
 {
  "start": 150.0,
  "end": 152.0,
  "text": "一,说过,二,想不起来"
 },
 {
  "start": 152.0,
  "end": 154.0,
  "text": "三,从来不说"
 },
 {
  "start": 154.0,
  "end": 155.0,
  "text": "这条建议你收藏"
 },
 {
  "start": 155.0,
  "end": 156.0,
  "text": "难受的时候呢"
 },
 {
  "start": 156.0,
  "end": 157.0,
  "text": "翻出来看一看"
 },
 {
  "start": 157.0,
  "end": 158.0,
  "text": "照着说一句"
 },
 {
  "start": 158.0,
  "end": 159.0,
  "text": "转给你嘛"
 },
 {
  "start": 159.0,
  "end": 160.0,
  "text": "他照着被指认"
 },
 {
  "start": 160.0,
  "end": 162.0,
  "text": "最不会说的三句话"
 },
 {
  "start": 162.0,
  "end": 163.0,
  "text": "下一讲,说说"
 },
 {
  "start": 163.0,
  "end": 165.0,
  "text": "有一件有点扎心的事"
 },
 {
  "start": 165.0,
  "end": 167.0,
  "text": "孩子长大了"
 },
 {
  "start": 167.0,
  "end": 169.0,
  "text": "不再需要你了"
 }
]