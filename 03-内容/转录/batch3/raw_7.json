[
 {
  "start": 0.5,
  "end": 3.94,
  "text": "你有多久没有给自己买过一样东西了"
 },
 {
  "start": 3.94,
  "end": 7.22,
  "text": "你给孩子买什么的时候你眼都不眨"
 },
 {
  "start": 7.22,
  "end": 10.14,
  "text": "但给自己买一件衣服你都要想三天"
 },
 {
  "start": 10.14,
  "end": 11.94,
  "text": "你打开手机记账"
 },
 {
  "start": 11.94,
  "end": 14.18,
  "text": "看看上个月孩子的"
 },
 {
  "start": 14.18,
  "end": 19.46,
  "text": "学费、学补习班、校服、牛奶、零食、家里的"
 },
 {
  "start": 19.46,
  "end": 21.86,
  "text": "米、油、水费、电费"
 },
 {
  "start": 21.86,
  "end": 23.54,
  "text": "你自己的有没有"
 },
 {
  "start": 23.54,
  "end": 25.1,
  "text": "我猜没有"
 },
 {
  "start": 25.1,
  "end": 26.66,
  "text": "就算有"
 },
 {
  "start": 26.66,
  "end": 28.78,
  "text": "也是给孩子买的时候"
 },
 {
  "start": 28.78,
  "end": 31.82,
  "text": "顺带的买了一双袜子"
 },
 {
  "start": 31.82,
  "end": 32.94,
  "text": "我认识一个妈妈"
 },
 {
  "start": 32.94,
  "end": 33.98,
  "text": "她跟我说"
 },
 {
  "start": 33.98,
  "end": 36.86,
  "text": "她有一次在商场看中一件外套"
 },
 {
  "start": 36.86,
  "end": 37.94,
  "text": "三百八"
 },
 {
  "start": 37.94,
  "end": 39.98,
  "text": "她站在那看了十分钟"
 },
 {
  "start": 39.98,
  "end": 41.26,
  "text": "然后走了"
 },
 {
  "start": 41.26,
  "end": 42.5,
  "text": "走了两步又回来"
 },
 {
  "start": 42.5,
  "end": 43.74,
  "text": "又看了三分钟"
 },
 {
  "start": 43.74,
  "end": 45.54,
  "text": "还是走了"
 },
 {
  "start": 45.54,
  "end": 46.7,
  "text": "后来她说"
 },
 {
  "start": 46.7,
  "end": 48.78,
  "text": "她回家给儿子买了个"
 },
 {
  "start": 48.78,
  "end": 50.62,
  "text": "三百九的乐糕"
 },
 {
  "start": 50.62,
  "end": 52.34,
  "text": "当场付款"
 },
 {
  "start": 52.34,
  "end": 53.14,
  "text": "我问她"
 },
 {
  "start": 53.14,
  "end": 55.22,
  "text": "那件外套"
 },
 {
  "start": 55.22,
  "end": 56.58,
  "text": "后来我买了没有"
 },
 {
  "start": 56.58,
  "end": 57.38,
  "text": "她说太贵了"
 },
 {
  "start": 57.38,
  "end": 58.38,
  "text": "没买"
 },
 {
  "start": 58.38,
  "end": 60.46,
  "text": "你以为这叫会过日子"
 },
 {
  "start": 60.46,
  "end": 61.38,
  "text": "其实不是"
 },
 {
  "start": 61.38,
  "end": 63.54,
  "text": "这叫我不配"
 },
 {
  "start": 63.54,
  "end": 65.18,
  "text": "你注意听这三个字"
 },
 {
  "start": 65.18,
  "end": 66.7,
  "text": "你给孩子花钱"
 },
 {
  "start": 66.7,
  "end": 68.02,
  "text": "还想着自己"
 },
 {
  "start": 69.94,
  "end": 70.54,
  "text": "怎么说呢"
 },
 {
  "start": 70.54,
  "end": 71.02,
  "text": "就是"
 },
 {
  "start": 72.46,
  "end": 74.02,
  "text": "你当你给孩子花钱的时候"
 },
 {
  "start": 74.02,
  "end": 75.54,
  "text": "你还想着自己说"
 },
 {
  "start": 75.54,
  "end": 76.38,
  "text": "我要不要去买"
 },
 {
  "start": 76.38,
  "end": 76.98,
  "text": "这个时候"
 },
 {
  "start": 76.98,
  "end": 78.78,
  "text": "你连自己都不想了"
 },
 {
  "start": 78.78,
  "end": 79.58,
  "text": "连自己都不想了"
 },
 {
  "start": 79.58,
  "end": 81.54,
  "text": "这个是我们做夫母"
 },
 {
  "start": 81.54,
  "end": 82.78,
  "text": "在某一个时间点"
 },
 {
  "start": 82.78,
  "end": 85.38,
  "text": "就比较比较被吹的地方"
 },
 {
  "start": 85.38,
  "end": 86.54,
  "text": "比较被吹的地方"
 },
 {
  "start": 87.3,
  "end": 88.7,
  "text": "因为呢"
 },
 {
  "start": 88.7,
  "end": 89.58,
  "text": "我们总会觉得"
 },
 {
  "start": 89.58,
  "end": 90.9,
  "text": "我们给自己花钱"
 },
 {
  "start": 90.9,
  "end": 92.34,
  "text": "总是太贵了"
 },
 {
  "start": 92.34,
  "end": 93.66,
  "text": "舍不得"
 },
 {
  "start": 93.66,
  "end": 94.26,
  "text": "对不对"
 },
 {
  "start": 94.26,
  "end": 95.5,
  "text": "同一个三百八的东西"
 },
 {
  "start": 95.5,
  "end": 96.18,
  "text": "在你心里的"
 },
 {
  "start": 96.18,
  "end": 97.34,
  "text": "其实是两个价格"
 },
 {
  "start": 97.34,
  "end": 98.22,
  "text": "你给儿子买个"
 },
 {
  "start": 98.22,
  "end": 99.78,
  "text": "三百九的乐糕的金木"
 },
 {
  "start": 99.78,
  "end": 100.9,
  "text": "但是你舍不得给自己"
 },
 {
  "start": 100.9,
  "end": 102.62,
  "text": "买个三百九的外套"
 },
 {
  "start": 102.62,
  "end": 103.86,
  "text": "那为什么会这样呢"
 },
 {
  "start": 103.86,
  "end": 105.9,
  "text": "因为从小听的是"
 },
 {
  "start": 105.9,
  "end": 107.58,
  "text": "你要懂事"
 },
 {
  "start": 107.58,
  "end": 109.22,
  "text": "你要让他弟弟妹妹"
 },
 {
  "start": 109.22,
  "end": 110.18,
  "text": "你都这么大了"
 },
 {
  "start": 110.18,
  "end": 111.18,
  "text": "还想着自己"
 },
 {
  "start": 111.18,
  "end": 113.26,
  "text": "这些话你听了半辈子"
 },
 {
  "start": 113.26,
  "end": 114.26,
  "text": "最后变成一句"
 },
 {
  "start": 114.26,
  "end": 116.82,
  "text": "我这个人就得排在最后"
 },
 {
  "start": 116.82,
  "end": 117.94,
  "text": "那怎么办呢"
 },
 {
  "start": 117.94,
  "end": 120.18,
  "text": "我们要要做三件事"
 },
 {
  "start": 120.18,
  "end": 120.98,
  "text": "还做一下改变"
 },
 {
  "start": 120.98,
  "end": 122.3,
  "text": "第一件小事"
 },
 {
  "start": 122.3,
  "end": 124.14,
  "text": "每个月给自己留一笔钱"
 },
 {
  "start": 124.14,
  "end": 125.58,
  "text": "不用多一百也行"
 },
 {
  "start": 125.58,
  "end": 126.3,
  "text": "两百也行"
 },
 {
  "start": 126.3,
  "end": 127.3,
  "text": "五十也行"
 },
 {
  "start": 127.3,
  "end": 128.14,
  "text": "但是每个月"
 },
 {
  "start": 128.14,
  "end": 130.1,
  "text": "要给自己留一笔钱"
 },
 {
  "start": 130.1,
  "end": 130.7,
  "text": "这笔钱"
 },
 {
  "start": 130.7,
  "end": 132.9,
  "text": "这种花在你自己身上"
 },
 {
  "start": 132.9,
  "end": 133.7,
  "text": "花不完"
 },
 {
  "start": 133.7,
  "end": 134.54,
  "text": "那也留着"
 },
 {
  "start": 134.54,
  "end": 135.46,
  "text": "不要裸用"
 },
 {
  "start": 135.46,
  "end": 136.34,
  "text": "第二件事"
 },
 {
  "start": 136.34,
  "end": 137.58,
  "text": "买东西的时候呢"
 },
 {
  "start": 137.58,
  "end": 138.66,
  "text": "别问值不值"
 },
 {
  "start": 138.66,
  "end": 141.5,
  "text": "问一句喜不喜欢"
 },
 {
  "start": 141.5,
  "end": 143.1,
  "text": "喜欢就是理由"
 },
 {
  "start": 143.1,
  "end": 144.7,
  "text": "你不需要别的理由"
 },
 {
  "start": 144.7,
  "end": 145.5,
  "text": "第三件"
 },
 {
  "start": 145.5,
  "end": 147.82,
  "text": "给自己买第一件东西的时候"
 },
 {
  "start": 147.82,
  "end": 149.7,
  "text": "挑看得见的"
 },
 {
  "start": 149.7,
  "end": 152.54,
  "text": "一双颜色比较星亮的鞋子"
 },
 {
  "start": 152.54,
  "end": 154.34,
  "text": "一个好看的杯子"
 },
 {
  "start": 154.34,
  "end": 156.14,
  "text": "你每天看见他"
 },
 {
  "start": 156.14,
  "end": 158.7,
  "text": "你的心情就会好起来"
 },
 {
  "start": 158.7,
  "end": 160.26,
  "text": "而且你也会想起来"
 },
 {
  "start": 160.26,
  "end": 162.82,
  "text": "我也是有人管的"
 },
 {
  "start": 162.82,
  "end": 163.7,
  "text": "我跟你讲"
 },
 {
  "start": 163.7,
  "end": 165.5,
  "text": "你对自己空不是省钱"
 },
 {
  "start": 165.5,
  "end": 166.46,
  "text": "不是省钱"
 },
 {
  "start": 166.46,
  "end": 168.66,
  "text": "你是在一遍一遍的告诉自己"
 },
 {
  "start": 168.66,
  "end": 170.42,
  "text": "我不值得"
 },
 {
  "start": 170.42,
  "end": 171.94,
  "text": "孩子看着你"
 },
 {
  "start": 171.94,
  "end": 174.06,
  "text": "你也学会怎么对待自己"
 },
 {
  "start": 174.06,
  "end": 175.5,
  "text": "你对自己好一点"
 },
 {
  "start": 175.5,
  "end": 178.42,
  "text": "是这个家具划算的投资"
 },
 {
  "start": 178.42,
  "end": 179.62,
  "text": "说到底还是一句话"
 },
 {
  "start": 179.62,
  "end": 181.5,
  "text": "你不是买不起那件衣服"
 },
 {
  "start": 181.5,
  "end": 184.42,
  "text": "你是觉得自己不配"
 },
 {
  "start": 184.42,
  "end": 185.62,
  "text": "别论区打个数字"
 },
 {
  "start": 185.62,
  "end": 188.06,
  "text": "你上一次给自己买东西"
 },
 {
  "start": 188.06,
  "end": 189.18,
  "text": "一 这个月"
 },
 {
  "start": 189.18,
  "end": 190.18,
  "text": "二 半年前"
 },
 {
  "start": 190.18,
  "end": 191.98,
  "text": "三 真想不起来了"
 },
 {
  "start": 191.98,
  "end": 193.26,
  "text": "这条收藏着"
 },
 {
  "start": 193.26,
  "end": 195.46,
  "text": "明天你去去买一件"
 },
 {
  "start": 195.46,
  "end": 196.94,
  "text": "你自己喜欢东西"
 },
 {
  "start": 196.94,
  "end": 197.82,
  "text": "十块钱也行"
 },
 {
  "start": 197.82,
  "end": 198.94,
  "text": "几块钱也行"
 },
 {
  "start": 198.94,
  "end": 200.74,
  "text": "给自己买一件东西"
 },
 {
  "start": 200.74,
  "end": 201.78,
  "text": "转给你的妈妈"
 },
 {
  "start": 201.78,
  "end": 204.94,
  "text": "她这辈子就不会给自己花钱"
 },
 {
  "start": 204.94,
  "end": 206.94,
  "text": "下一讲说说那个总说"
 },
 {
  "start": 206.94,
  "end": 208.62,
  "text": "我没事的妈妈"
 }
]