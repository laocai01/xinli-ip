[
 {
  "start": 0.37,
  "end": 2.37,
  "text": "大家好 我是老蔡"
 },
 {
  "start": 2.37,
  "end": 5.37,
  "text": "这两天又因为家里的事断更了两天"
 },
 {
  "start": 5.37,
  "end": 7.37,
  "text": "算今天算三天"
 },
 {
  "start": 7.37,
  "end": 10.37,
  "text": "接下来我们讲一下下一讲"
 },
 {
  "start": 10.37,
  "end": 13.37,
  "text": "四十岁以后 朋友是一个没的"
 },
 {
  "start": 13.37,
  "end": 17.14,
  "text": "这是当年翻遍通讯录"
 },
 {
  "start": 17.14,
  "end": 19.14,
  "text": "能半夜打电话的人 还剩几个呢"
 },
 {
  "start": 19.14,
  "end": 23.71,
  "text": "不是没人 是敢打的人 没了"
 },
 {
  "start": 23.71,
  "end": 27.22,
  "text": "我给你写一段话吧"
 },
 {
  "start": 27.22,
  "end": 30.22,
  "text": "不是替别人写的 是替你自己写的"
 },
 {
  "start": 30.22,
  "end": 35.1,
  "text": "这时候呢，你40岁那年就想打出去，一直没打"
 },
 {
  "start": 35.1,
  "end": 38.14,
  "text": "老程，我是老蔡"
 },
 {
  "start": 38.14,
  "end": 41.84,
  "text": "你爸那次住院，你在走廊里坐了凉宿"
 },
 {
  "start": 41.84,
  "end": 43.64,
  "text": "我到现在还记得"
 },
 {
  "start": 43.64,
  "end": 45.64,
  "text": "我不是来问你爸怎么样的"
 },
 {
  "start": 45.64,
  "end": 47.64,
  "text": "我就是想跟你说"
 },
 {
  "start": 47.64,
  "end": 50.14,
  "text": "那两宿你是一个人扛的"
 },
 {
  "start": 50.14,
  "end": 52.64,
  "text": "我这手机里存着你的号"
 },
 {
  "start": 52.64,
  "end": 54.14,
  "text": "存了十几年了"
 },
 {
  "start": 54.14,
  "end": 57.14,
  "text": "逢年过节，想发条消息"
 },
 {
  "start": 57.14,
  "end": 60.68,
  "text": "编辑框打开，打了三上，打了删"
 },
 {
  "start": 60.68,
  "end": 63.48,
  "text": "最后发出去的确是个表情"
 },
 {
  "start": 64.13,
  "end": 67.81,
  "text": "今天不发了 这一句有空给我回个电话"
 },
 {
  "start": 67.81,
  "end": 70.33,
  "text": "说一句 我在就行"
 },
 {
  "start": 73.01,
  "end": 75.33,
  "text": "这时候你手机里还存着吗"
 },
 {
  "start": 75.33,
  "end": 79.61,
  "text": "没有 因为你从来就没有写过"
 },
 {
  "start": 79.61,
  "end": 83.29,
  "text": "不是写不出来 是每次写出来之前"
 },
 {
  "start": 83.29,
  "end": 85.33,
  "text": "你自己就先否定了它"
 },
 {
  "start": 86.28,
  "end": 89.2,
  "text": "人家在忙 这么久没联系了"
 },
 {
  "start": 89.56,
  "end": 91.8,
  "text": "或者是人家以为我要借钱"
 },
 {
  "start": 92.6,
  "end": 94.76,
  "text": "你先把路给堵死了"
 },
 {
  "start": 94.76,
  "end": 97.71,
  "text": "然后你说没有人可以讲"
 },
 {
  "start": 97.71,
  "end": 99.75,
  "text": "我再替你说第二段"
 },
 {
  "start": 99.75,
  "end": 101.39,
  "text": "这句更难开口"
 },
 {
  "start": 101.39,
  "end": 104.68,
  "text": "是给你那几个走散了的、的朋友的"
 },
 {
  "start": 104.68,
  "end": 106.72,
  "text": "我不是不在乎你们了"
 },
 {
  "start": 106.72,
  "end": 108.6,
  "text": "我是从某一年开始"
 },
 {
  "start": 108.6,
  "end": 110.48,
  "text": "一件事接着一件事"
 },
 {
  "start": 110.48,
  "end": 113.28,
  "text": "孩子上学 老人住院"
 },
 {
  "start": 113.28,
  "end": 114.68,
  "text": "单位裁员"
 },
 {
  "start": 114.68,
  "end": 116.8,
  "text": "一件事赶一件事"
 },
 {
  "start": 116.8,
  "end": 118.08,
  "text": "等我抬头的时候呢"
 },
 {
  "start": 118.08,
  "end": 120.28,
  "text": "已经好几年过去了"
 },
 {
  "start": 120.28,
  "end": 122.29,
  "text": "不是我忘了你们"
 },
 {
  "start": 122.29,
  "end": 125.11,
  "text": "是我一直觉得等我缓过这阵子"
 },
 {
  "start": 125.87,
  "end": 127.93,
  "text": "可这阵子一直没缓过来"
 },
 {
  "start": 129.04,
  "end": 130.58,
  "text": "这段话你敢不敢发"
 },
 {
  "start": 131.03,
  "end": 134.87,
  "text": "我告诉你 敢发的人 最后都收到一句回话"
 },
 {
  "start": 135.39,
  "end": 136.41,
  "text": "我也一样"
 },
 {
  "start": 138.25,
  "end": 140.05,
  "text": "你不用写完整"
 },
 {
  "start": 140.31,
  "end": 143.37,
  "text": "你也可以只发四个字 我挺好的"
 },
 {
  "start": 144.53,
  "end": 147.09,
  "text": "这句话在这里不是说你要装"
 },
 {
  "start": 147.35,
  "end": 148.89,
  "text": "是你告诉对方"
 },
 {
  "start": 149.15,
  "end": 151.19,
  "text": "我还记得你 我还在"
 },
 {
  "start": 152.43,
  "end": 153.97,
  "text": "我在评论区等你"
 },
 {
  "start": 153.97,
  "end": 159.22,
  "text": "把这两段你准备发出去的那一句写在下面"
 },
 {
  "start": 159.22,
  "end": 161.38,
  "text": "不是全文就写一句话"
 },
 {
  "start": 161.38,
  "end": 164.38,
  "text": "写在评论区写出来的那一刻"
 },
 {
  "start": 164.38,
  "end": 166.38,
  "text": "其实你已经发出去一半了"
 },
 {
  "start": 166.38,
  "end": 170.02,
  "text": "把你们想写的话留在评论区里"
 },
 {
  "start": 170.02,
  "end": 172.02,
  "text": "一个是给自己看"
 },
 {
  "start": 172.02,
  "end": 175.02,
  "text": "第二个也是给我们有相同经历的人去看"
 },
 {
  "start": 175.02,
  "end": 177.05,
  "text": "关注我"
 },
 {
  "start": 177.05,
  "end": 181.05,
  "text": "我讲的是一个家里没说出口的话"
 },
 {
  "start": 181.05,
  "end": 182.05,
  "text": "下一讲"
 },
 {
  "start": 182.05,
  "end": 185.05,
  "text": "我说一个你可能没有注意过的事"
 },
 {
  "start": 185.05,
  "end": 188.49,
  "text": "孩子摔门的那一下，他在说什么"
 }
]