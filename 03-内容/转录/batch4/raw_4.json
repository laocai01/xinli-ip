[
 {
  "start": 0.78,
  "end": 4.82,
  "text": "你不敢生病 因为没人替你"
 },
 {
  "start": 4.82,
  "end": 10.29,
  "text": "呃 你不是怕疼 你是怕倒下"
 },
 {
  "start": 10.29,
  "end": 13.06,
  "text": "这个家没人管"
 },
 {
  "start": 13.06,
  "end": 16.09,
  "text": "今天我不讲道理 我给你五道题"
 },
 {
  "start": 16.09,
  "end": 20.22,
  "text": "我们自己去看一看 自己对一对中了几条"
 },
 {
  "start": 20.22,
  "end": 22.22,
  "text": "第一条 你发烧了"
 },
 {
  "start": 22.22,
  "end": 25.66,
  "text": "先想的不是我得去看病"
 },
 {
  "start": 25.66,
  "end": 30.79,
  "text": "是我今天有几件事都不能耽搁 中了没有"
 },
 {
  "start": 30.79,
  "end": 32.63,
  "text": "第二条 你去看病"
 },
 {
  "start": 32.63,
  "end": 34.47,
  "text": "医生说要住院"
 },
 {
  "start": 34.47,
  "end": 38.74,
  "text": "你第一句话认得不是严不严重"
 },
 {
  "start": 38.74,
  "end": 41.43,
  "text": "反而是“得住几天”"
 },
 {
  "start": 41.43,
  "end": 42.67,
  "text": "中了没有"
 },
 {
  "start": 42.67,
  "end": 44.81,
  "text": "第三条 你吃药"
 },
 {
  "start": 44.81,
  "end": 47.41,
  "text": "你不按盒子上写的量去吃"
 },
 {
  "start": 47.41,
  "end": 51.67,
  "text": "你说省着点吃 吃一半也行"
 },
 {
  "start": 51.67,
  "end": 54.47,
  "text": "第四条 家里的人体检"
 },
 {
  "start": 54.47,
  "end": 57.57,
  "text": "你年年催 但是你自己的呢"
 },
 {
  "start": 57.57,
  "end": 61.37,
  "text": "你自己的都已经好几年没去查过了"
 },
 {
  "start": 61.37,
  "end": 66.97,
  "text": "第五条,你半夜心慌、腰痛、头晕、翻来覆去"
 },
 {
  "start": 66.97,
  "end": 70.97,
  "text": "第二天你跟家里人说没事,去闹疹了"
 },
 {
  "start": 70.97,
  "end": 75.74,
  "text": "这五条我们很多中年人都有遇到过"
 },
 {
  "start": 75.74,
  "end": 77.75,
  "text": "你做了几条呢?"
 },
 {
  "start": 77.75,
  "end": 80.95,
  "text": "我告诉你,这五条连起来是什么?"
 },
 {
  "start": 80.95,
  "end": 85.95,
  "text": "不是你不爱惜身体,是你一直在算一个账"
 },
 {
  "start": 85.95,
  "end": 90.06,
  "text": "我倒下这一天值多少钱?"
 },
 {
  "start": 90.06,
  "end": 93.26,
  "text": "所以算来算去永远都是同一个答案"
 },
 {
  "start": 93.26,
  "end": 96.04,
  "text": "我不能倒"
 },
 {
  "start": 96.04,
  "end": 98.34,
  "text": "可这个账你算漏了一笔"
 },
 {
  "start": 98.34,
  "end": 101.04,
  "text": "你没算你要是真到了那一天"
 },
 {
  "start": 101.04,
  "end": 104.99,
  "text": "那这笔账谁来算"
 },
 {
  "start": 104.99,
  "end": 107.79,
  "text": "今天我们要讲的是这五条里面"
 },
 {
  "start": 107.79,
  "end": 110.09,
  "text": "你今天中了几条打个数字"
 },
 {
  "start": 110.09,
  "end": 111.29,
  "text": "打在评论区"
 },
 {
  "start": 111.29,
  "end": 112.99,
  "text": "就一个数字打出来"
 },
 {
  "start": 112.99,
  "end": 115.09,
  "text": "你会发现评论区一大堆人"
 },
 {
  "start": 115.09,
  "end": 117.59,
  "text": "都是跟你一样的数字"
 },
 {
  "start": 117.59,
  "end": 118.19,
  "text": "关注我"
 },
 {
  "start": 118.19,
  "end": 120.49,
  "text": "我讲的是中年人不敢说的那点事"
 },
 {
  "start": 120.49,
  "end": 122.19,
  "text": "下一讲我说说那句"
 },
 {
  "start": 122.19,
  "end": 123.73,
  "text": "打一顿就好"
 },
 {
  "start": 123.73,
  "end": 126.53,
  "text": "这句话我欠你一辈子都别再说了"
 }
]