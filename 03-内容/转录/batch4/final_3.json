[
 {
  "start": 1.14,
  "end": 4.14,
  "text": "你不是身体累 是心累"
 },
 {
  "start": 4.14,
  "end": 7.14,
  "text": "当我们睡觉起来 觉得还是累"
 },
 {
  "start": 7.14,
  "end": 9.65,
  "text": "那不是身体的事"
 },
 {
  "start": 9.65,
  "end": 11.65,
  "text": "今天还是一样"
 },
 {
  "start": 11.65,
  "end": 13.65,
  "text": "只教你一句 换掉一样东西"
 },
 {
  "start": 13.65,
  "end": 14.65,
  "text": "伤什么呢"
 },
 {
  "start": 14.65,
  "end": 17.65,
  "text": "换掉你每天早上那句"
 },
 {
  "start": 17.65,
  "end": 19.74,
  "text": "我该起床了"
 },
 {
  "start": 19.74,
  "end": 21.74,
  "text": "你听清楚 不是换掉起床"
 },
 {
  "start": 21.74,
  "end": 24.74,
  "text": "是换掉“该”这个字"
 },
 {
  "start": 24.74,
  "end": 26.87,
  "text": "你自己回想一下"
 },
 {
  "start": 26.87,
  "end": 29.87,
  "text": "早上闹钟响的那一下"
 },
 {
  "start": 29.87,
  "end": 33.07,
  "text": "你脑子里的第一句话是什么"
 },
 {
  "start": 33.07,
  "end": 34.61,
  "text": "不是天亮了"
 },
 {
  "start": 34.61,
  "end": 38.12,
  "text": "是我该起了"
 },
 {
  "start": 38.12,
  "end": 39.16,
  "text": "是我该起了"
 },
 {
  "start": 39.16,
  "end": 40.68,
  "text": "这里面有三个字"
 },
 {
  "start": 40.68,
  "end": 42.48,
  "text": "天天在消耗你"
 },
 {
  "start": 42.48,
  "end": 44.18,
  "text": "该"
 },
 {
  "start": 44.18,
  "end": 45.32,
  "text": "得"
 },
 {
  "start": 45.32,
  "end": 47.15,
  "text": "应该"
 },
 {
  "start": 47.15,
  "end": 49.71,
  "text": "这三个字天天在消耗我们的精神"
 },
 {
  "start": 49.71,
  "end": 50.73,
  "text": "我们的状态"
 },
 {
  "start": 50.73,
  "end": 52.46,
  "text": "我们的想法"
 },
 {
  "start": 52.46,
  "end": 53.74,
  "text": "我给你讲一件事"
 },
 {
  "start": 53.74,
  "end": 56.3,
  "text": "一个人的累是分两种"
 },
 {
  "start": 56.3,
  "end": 58.62,
  "text": "一个是身体上的累"
 },
 {
  "start": 58.62,
  "end": 60.66,
  "text": "这个身体上的累，睡一觉就好"
 },
 {
  "start": 60.66,
  "end": 62.7,
  "text": "另一种是心里有一个人"
 },
 {
  "start": 62.7,
  "end": 65.1,
  "text": "一直在拿绳子牵着你"
 },
 {
  "start": 65.1,
  "end": 66.32,
  "text": "该做饭了"
 },
 {
  "start": 66.32,
  "end": 67.32,
  "text": "该回电话了"
 },
 {
  "start": 67.32,
  "end": 68.72,
  "text": "该去看看老人了"
 },
 {
  "start": 68.72,
  "end": 70.12,
  "text": "该省点钱了"
 },
 {
  "start": 70.12,
  "end": 73.8,
  "text": "这根绳子一刻都没有松过"
 },
 {
  "start": 73.8,
  "end": 75.2,
  "text": "你睡觉的时候呢"
 },
 {
  "start": 75.2,
  "end": 76.4,
  "text": "绳子也没松"
 },
 {
  "start": 76.4,
  "end": 80.36,
  "text": "所以你睡了八个小时起来还是累"
 },
 {
  "start": 80.36,
  "end": 81.96,
  "text": "不是身体没歇好"
 },
 {
  "start": 81.96,
  "end": 86.07,
  "text": "是那根绳子没有歇"
 },
 {
  "start": 86.07,
  "end": 88.97,
  "text": "把那根绳子掐了剪断"
 },
 {
  "start": 88.97,
  "end": 89.77,
  "text": "不行"
 },
 {
  "start": 89.77,
  "end": 91.77,
  "text": "因为那根绳子连着你的家"
 },
 {
  "start": 91.77,
  "end": 93.17,
  "text": "你不敢剪"
 },
 {
  "start": 93.17,
  "end": 95.17,
  "text": "当你可以做一件事情"
 },
 {
  "start": 95.17,
  "end": 100.28,
  "text": "把“该”那个字换成一个“我”字"
 },
 {
  "start": 100.28,
  "end": 103.28,
  "text": "我该起了 改成我起了"
 },
 {
  "start": 103.28,
  "end": 106.48,
  "text": "我该去做饭了 改成我要去做饭"
 },
 {
  "start": 106.48,
  "end": 108.54,
  "text": "我该去看看我妈了"
 },
 {
  "start": 108.54,
  "end": 112.28,
  "text": "改成我去看看我妈"
 },
 {
  "start": 112.28,
  "end": 113.68,
  "text": "到我们改完以后"
 },
 {
  "start": 113.68,
  "end": 116.28,
  "text": "整个人的状态跟心里的想法"
 },
 {
  "start": 116.28,
  "end": 118.0,
  "text": "它是不一样的"
 },
 {
  "start": 118.0,
  "end": 120.6,
  "text": "其实呢 一件事没少"
 },
 {
  "start": 120.6,
  "end": 123.6,
  "text": "当那个拿鞭子的人不见了"
 },
 {
  "start": 123.6,
  "end": 126.0,
  "text": "你从被催着走 被赶着走"
 },
 {
  "start": 126.0,
  "end": 128.0,
  "text": "变成了自己再去动"
 },
 {
  "start": 128.0,
  "end": 129.58,
  "text": "自己再去走"
 },
 {
  "start": 129.58,
  "end": 132.18,
  "text": "我知道你会说这不就是换个说法而已吗"
 },
 {
  "start": 132.18,
  "end": 133.18,
  "text": "能有用吗"
 },
 {
  "start": 133.18,
  "end": 134.18,
  "text": "我跟你讲"
 },
 {
  "start": 134.18,
  "end": 136.18,
  "text": "你自己试一天两天"
 },
 {
  "start": 136.18,
  "end": 137.58,
  "text": "就这一两天"
 },
 {
  "start": 137.58,
  "end": 140.18,
  "text": "每天早上闹钟响 你什么都不用想"
 },
 {
  "start": 140.18,
  "end": 141.18,
  "text": "就说三个字"
 },
 {
  "start": 141.18,
  "end": 143.54,
  "text": "我起来了"
 },
 {
  "start": 143.54,
  "end": 144.94,
  "text": "这条也不用你收藏"
 },
 {
  "start": 144.94,
  "end": 146.54,
  "text": "你就记住三个字而已"
 },
 {
  "start": 146.54,
  "end": 147.34,
  "text": "我起来了"
 },
 {
  "start": 147.34,
  "end": 149.34,
  "text": "或者把它该字给我换掉"
 },
 {
  "start": 149.34,
  "end": 150.34,
  "text": "记不住的话呢"
 },
 {
  "start": 150.34,
  "end": 152.14,
  "text": "评论区打一个字给我"
 },
 {
  "start": 152.14,
  "end": 153.43,
  "text": "该"
 },
 {
  "start": 153.43,
  "end": 156.03,
  "text": "就当是你认领的这根绳子"
 },
 {
  "start": 156.03,
  "end": 157.85,
  "text": "关注我"
 },
 {
  "start": 157.85,
  "end": 160.85,
  "text": "我讲的都是一些中年人说出口"
 },
 {
  "start": 160.85,
  "end": 162.85,
  "text": "又咽回去的话"
 },
 {
  "start": 162.85,
  "end": 166.25,
  "text": "现在讲的我说一件中年人多躲不开的事"
 },
 {
  "start": 166.25,
  "end": 169.65,
  "text": "你不敢生病因为没人替你"
 }
]