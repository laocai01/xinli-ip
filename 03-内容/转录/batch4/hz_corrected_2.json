[
 {
  "start": 1.3,
  "end": 5.66,
  "text": "孩子摔门的那一下 他在说什么"
 },
 {
  "start": 5.66,
  "end": 8.06,
  "text": "其实那一下 他并不是不尊重你"
 },
 {
  "start": 8.06,
  "end": 12.71,
  "text": "是他不会说 我现在很乱"
 },
 {
  "start": 12.71,
  "end": 16.06,
  "text": "咱们倒回去 看一下那三秒钟"
 },
 {
  "start": 16.06,
  "end": 18.3,
  "text": "第一秒 他站起来"
 },
 {
  "start": 18.3,
  "end": 22.14,
  "text": "椅子在地板上刮了一下 你没有抬头"
 },
 {
  "start": 22.14,
  "end": 24.06,
  "text": "第二秒 他转身"
 },
 {
  "start": 24.06,
  "end": 26.78,
  "text": "往前走了两步 走到自己的门口"
 },
 {
  "start": 26.78,
  "end": 30.18,
  "text": "你这时候说了一句 你什么态度"
 },
 {
  "start": 30.18,
  "end": 33.86,
  "text": "第三秒 门关上了 砰"
 },
 {
  "start": 33.86,
  "end": 36.3,
  "text": "你听见的是那个砰"
 },
 {
  "start": 36.3,
  "end": 39.58,
  "text": "你没听见的是前面的那两秒"
 },
 {
  "start": 39.58,
  "end": 42.74,
  "text": "怎么把这三秒再走一遍"
 },
 {
  "start": 42.74,
  "end": 44.5,
  "text": "这次我们走慢一点"
 },
 {
  "start": 44.56,
  "end": 46.6,
  "text": "第一秒当他站起来的时候"
 },
 {
  "start": 46.6,
  "end": 48.96,
  "text": "他站起来之前其实已经忍了很久"
 },
 {
  "start": 48.96,
  "end": 50.04,
  "text": "你知道吗"
 },
 {
  "start": 50.04,
  "end": 52.6,
  "text": "可能是在往前那一句"
 },
 {
  "start": 52.6,
  "end": 54.12,
  "text": "你又是这样"
 },
 {
  "start": 54.12,
  "end": 59.04,
  "text": "可能是你进门看见他玩手机那一刻在叹气"
 },
 {
  "start": 59.04,
  "end": 61.7,
  "text": "第二秒他走了两步"
 },
 {
  "start": 61.7,
  "end": 65.2,
  "text": "那两步是他给你的最后一次机会"
 },
 {
  "start": 65.2,
  "end": 68.4,
  "text": "你看 他没有直接去摔门"
 },
 {
  "start": 68.4,
  "end": 72.4,
  "text": "他先走了两步 走到门口 他慢了半拍"
 },
 {
  "start": 72.4,
  "end": 75.84,
  "text": "那半拍是在等你的一句话"
 },
 {
  "start": 75.84,
  "end": 80.39,
  "text": "但你没说 你说的反而是你什么态度"
 },
 {
  "start": 80.39,
  "end": 82.92,
  "text": "第三秒 门关上了"
 },
 {
  "start": 82.92,
  "end": 86.92,
  "text": "门关上的那一刻 他想的并不是我要气你"
 },
 {
  "start": 86.92,
  "end": 90.42,
  "text": "他想的是 终于没人看我了"
 },
 {
  "start": 90.42,
  "end": 94.54,
  "text": "怎么把这三秒复盘完以后呢"
 },
 {
  "start": 94.54,
  "end": 96.73,
  "text": "你会发现问题在哪呢"
 },
 {
  "start": 96.73,
  "end": 98.13,
  "text": "不是在第三秒"
 },
 {
  "start": 98.13,
  "end": 101.06,
  "text": "其实是在第二秒的那半拍"
 },
 {
  "start": 101.06,
  "end": 103.94,
  "text": "你只有那半拍的机会"
 },
 {
  "start": 103.94,
  "end": 105.98,
  "text": "我不是说要教你们什么方法"
 },
 {
  "start": 105.98,
  "end": 107.98,
  "text": "其实这也是我在学习过程当中"
 },
 {
  "start": 107.98,
  "end": 109.18,
  "text": "我学习到的"
 },
 {
  "start": 109.18,
  "end": 110.78,
  "text": "我也就想让大家知道"
 },
 {
  "start": 110.78,
  "end": 113.14,
  "text": "那一摔门不是让你关门"
 },
 {
  "start": 113.14,
  "end": 113.98,
  "text": "也不是光"
 },
 {
  "start": 113.98,
  "end": 114.48,
  "text": "不是你关"
 },
 {
  "start": 114.48,
  "end": 114.98,
  "text": "也不是他"
 },
 {
  "start": 114.98,
  "end": 116.34,
  "text": "是他关的"
 },
 {
  "start": 116.34,
  "end": 119.63,
  "text": "但那半拍是你错过的那半拍"
 },
 {
  "start": 119.63,
  "end": 122.26,
  "text": "你要是也有这么一摔门"
 },
 {
  "start": 122.26,
  "end": 125.56,
  "text": "把你错过的那半拍说给我听"
 },
 {
  "start": 125.56,
  "end": 127.46,
  "text": "评论区一句话就够"
 },
 {
  "start": 127.46,
  "end": 129.86,
  "text": "就当相同的场景出现的时候"
 },
 {
  "start": 129.86,
  "end": 134.18,
  "text": "那半拍你当时想表达的是什么"
 },
 {
  "start": 134.18,
  "end": 137.71,
  "text": "放在评论区我们一起聊一聊"
 },
 {
  "start": 137.71,
  "end": 138.21,
  "text": "关注我"
 },
 {
  "start": 138.21,
  "end": 141.21,
  "text": "我讲的是一个家里没说出口的话"
 },
 {
  "start": 141.21,
  "end": 144.81,
  "text": "下一讲我说个可能一直搞错的事"
 },
 {
  "start": 144.81,
  "end": 147.61,
  "text": "你不是身体累是心累"
 }
]