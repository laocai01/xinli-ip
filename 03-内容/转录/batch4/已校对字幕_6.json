[
 {
  "start": 0.46,
  "end": 4.46,
  "text": "你爸妈老了以后呢 最怕的其实不是生病"
 },
 {
  "start": 4.46,
  "end": 8.91,
  "text": "前几天我听见一句话 我有一个同事跟我说的"
 },
 {
  "start": 8.91,
  "end": 13.42,
  "text": "他说 他妈是一位七十多岁的阿姨"
 },
 {
  "start": 13.42,
  "end": 19.42,
  "text": "他说 他妈跟他说 我少给你打点电话 你在单位忙"
 },
 {
  "start": 19.42,
  "end": 22.42,
  "text": "就这一句话 今天我不讲别的啊"
 },
 {
  "start": 22.42,
  "end": 25.42,
  "text": "我们把这句话拆开来 拆开来看一看"
 },
 {
  "start": 25.42,
  "end": 30.42,
  "text": "想一想 第一层是你的爸妈在体谅你"
 },
 {
  "start": 30.42,
  "end": 33.36,
  "text": "这一层是真的，因为他知道你忙"
 },
 {
  "start": 33.36,
  "end": 36.0,
  "text": "知道你有你的家，知道你不容易"
 },
 {
  "start": 36.0,
  "end": 38.0,
  "text": "他是真心的在疼你"
 },
 {
  "start": 38.0,
  "end": 40.6,
  "text": "第二层他在给你让路"
 },
 {
  "start": 40.6,
  "end": 45.02,
  "text": "你再听一遍，我少给你打电话"
 },
 {
  "start": 45.02,
  "end": 47.02,
  "text": "这句话你没有问我"
 },
 {
  "start": 47.02,
  "end": 50.45,
  "text": "没有我不高兴，没有你怎么不给我打"
 },
 {
  "start": 50.45,
  "end": 53.25,
  "text": "他把所有的想法都咽下去了"
 },
 {
  "start": 53.25,
  "end": 55.97,
  "text": "只留下一个动作，退后一步"
 },
 {
  "start": 55.97,
  "end": 59.51,
  "text": "第三层他已经知道答案了"
 },
 {
  "start": 59.51,
  "end": 61.48,
  "text": "他不是来商量的"
 },
 {
  "start": 61.48,
  "end": 62.72,
  "text": "他已经默认了"
 },
 {
  "start": 62.72,
  "end": 64.02,
  "text": "默许了他的电话"
 },
 {
  "start": 64.02,
  "end": 66.78,
  "text": "对你来说是一个打扰"
 },
 {
  "start": 66.78,
  "end": 68.58,
  "text": "这一层最扎人"
 },
 {
  "start": 68.58,
  "end": 69.58,
  "text": "你再想想"
 },
 {
  "start": 69.58,
  "end": 72.18,
  "text": "这句话他是怎么说出口的"
 },
 {
  "start": 72.18,
  "end": 75.18,
  "text": "一定是有那么一次你说过什么"
 },
 {
  "start": 75.18,
  "end": 76.88,
  "text": "可能是那一天他打过来"
 },
 {
  "start": 76.88,
  "end": 78.88,
  "text": "他打过来你正在开会"
 },
 {
  "start": 78.88,
  "end": 80.78,
  "text": "你说妈我待会再回你"
 },
 {
  "start": 80.78,
  "end": 82.18,
  "text": "然后你忘了"
 },
 {
  "start": 82.18,
  "end": 85.18,
  "text": "也可能是那一天他说了一遍 你没有回"
 },
 {
  "start": 85.18,
  "end": 87.38,
  "text": "第二遍你语气重了一点"
 },
 {
  "start": 87.38,
  "end": 89.58,
  "text": "他说我不问了"
 },
 {
  "start": 89.58,
  "end": 91.58,
  "text": "可是那天你回家"
 },
 {
  "start": 91.58,
  "end": 92.58,
  "text": "他问东问西"
 },
 {
  "start": 92.58,
  "end": 93.58,
  "text": "你说行了行了"
 },
 {
  "start": 93.58,
  "end": 95.06,
  "text": "我知道了"
 },
 {
  "start": 95.06,
  "end": 98.06,
  "text": "你把门轻轻的带上"
 },
 {
  "start": 98.06,
  "end": 101.09,
  "text": "然后他自己也把门锁上了"
 },
 {
  "start": 101.09,
  "end": 102.09,
  "text": "他现在这句"
 },
 {
  "start": 102.09,
  "end": 103.09,
  "text": "我少给你打点电话"
 },
 {
  "start": 103.09,
  "end": 105.09,
  "text": "不是他不爱说话了"
 },
 {
  "start": 105.09,
  "end": 106.09,
  "text": "是他学会了"
 },
 {
  "start": 106.09,
  "end": 108.09,
  "text": "说话要看你的脸色"
 },
 {
  "start": 108.09,
  "end": 109.09,
  "text": "他七十多岁"
 },
 {
  "start": 109.09,
  "end": 111.09,
  "text": "在自己的孩子面前"
 },
 {
  "start": 111.09,
  "end": 112.09,
  "text": "开始看脸色了"
 },
 {
  "start": 112.09,
  "end": 114.34,
  "text": "我也常犯这个毛病"
 },
 {
  "start": 114.34,
  "end": 115.86,
  "text": "我讲这些呢"
 },
 {
  "start": 115.86,
  "end": 117.86,
  "text": "不是站在旁边说你"
 },
 {
  "start": 117.86,
  "end": 118.86,
  "text": "是我们也一样"
 },
 {
  "start": 118.86,
  "end": 119.86,
  "text": "我也一样"
 },
 {
  "start": 119.86,
  "end": 122.39,
  "text": "评论区我请你们说一句"
 },
 {
  "start": 122.39,
  "end": 124.31,
  "text": "下一次你妈给你打电话"
 },
 {
  "start": 124.31,
  "end": 126.11,
  "text": "你的第一句话是什么"
 },
 {
  "start": 126.11,
  "end": 127.71,
  "text": "是妈咋啦"
 },
 {
  "start": 127.71,
  "end": 129.51,
  "text": "还是说妈我现在忙"
 },
 {
  "start": 129.51,
  "end": 131.57,
  "text": "说实话就行"
 },
 {
  "start": 131.57,
  "end": 133.69,
  "text": "因为我们都说实话 在评论区"
 },
 {
  "start": 133.69,
  "end": 135.27,
  "text": "关注我"
 },
 {
  "start": 135.27,
  "end": 138.27,
  "text": "我讲的都是一个家里没说出口的话"
 },
 {
  "start": 138.27,
  "end": 139.27,
  "text": "下一讲"
 },
 {
  "start": 139.27,
  "end": 141.67,
  "text": "我说可能有点扎心的话"
 },
 {
  "start": 141.67,
  "end": 146.07,
  "text": "老了以后最没用的那句话是想开点"
 }
]