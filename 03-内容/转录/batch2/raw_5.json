{
 "n": 5,
 "src": "5.mp4",
 "duration": 208.34,
 "segs": [
  {
   "start": 0.34,
   "end": 4.34,
   "text": "你是不是越来越不敢麻烦孩子了"
  },
  {
   "start": 4.34,
   "end": 6.84,
   "text": "你并不是不想他"
  },
  {
   "start": 6.84,
   "end": 9.84,
   "text": "你是把自己变成了负当"
  },
  {
   "start": 9.84,
   "end": 12.84,
   "text": "你把我想你说成了"
  },
  {
   "start": 12.84,
   "end": 15.34,
   "text": "你瞒你的 不用管我"
  },
  {
   "start": 15.34,
   "end": 17.34,
   "text": "你有没有干过这些事"
  },
  {
   "start": 17.34,
   "end": 20.34,
   "text": "打电话过去听见内头很吵"
  },
  {
   "start": 20.34,
   "end": 23.34,
   "text": "你赶紧说你瞒吧 没啥事"
  },
  {
   "start": 23.34,
   "end": 26.34,
   "text": "身上不舒服 孩子愿起来"
  },
  {
   "start": 26.34,
   "end": 28.34,
   "text": "你说没事没事 老毛病了"
  },
  {
   "start": 28.34,
   "end": 31.34,
   "text": "孩子要给你转钱 你说不用不用"
  },
  {
   "start": 31.34,
   "end": 33.34,
   "text": "我够花"
  },
  {
   "start": 33.34,
   "end": 35.34,
   "text": "你以为这叫懂事"
  },
  {
   "start": 35.34,
   "end": 38.34,
   "text": "我告诉你 这叫一把门"
  },
  {
   "start": 38.34,
   "end": 42.34,
   "text": "一点点一点点的关上"
  },
  {
   "start": 42.34,
   "end": 44.34,
   "text": "我认识一位退休的老师"
  },
  {
   "start": 44.34,
   "end": 46.34,
   "text": "他儿子在外地"
  },
  {
   "start": 46.34,
   "end": 48.34,
   "text": "有一回他自己去复查"
  },
  {
   "start": 48.34,
   "end": 50.34,
   "text": "一个人去的"
  },
  {
   "start": 50.34,
   "end": 52.34,
   "text": "排到号的时候 护士问"
  },
  {
   "start": 52.34,
   "end": 54.34,
   "text": "你家人呢"
  },
  {
   "start": 54.34,
   "end": 56.34,
   "text": "他说我没家属"
  },
  {
   "start": 56.34,
   "end": 57.34,
   "text": "他说这两个字的时候"
  },
  {
   "start": 57.34,
   "end": 60.34,
   "text": "语气特别的平常"
  },
  {
   "start": 60.34,
   "end": 63.34,
   "text": "可我在旁边听着心里一挤"
  },
  {
   "start": 63.34,
   "end": 65.34,
   "text": "他不是不需要人"
  },
  {
   "start": 65.34,
   "end": 67.34,
   "text": "他是怕自己一开口"
  },
  {
   "start": 67.34,
   "end": 69.34,
   "text": "就成了麻烦"
  },
  {
   "start": 69.34,
   "end": 71.34,
   "text": "你以为你少麻烦他"
  },
  {
   "start": 71.34,
   "end": 73.34,
   "text": "他就轻松了"
  },
  {
   "start": 73.34,
   "end": 74.34,
   "text": "其实不是"
  },
  {
   "start": 74.34,
   "end": 77.34,
   "text": "他累的从来不是帮你"
  },
  {
   "start": 77.34,
   "end": 78.34,
   "text": "帮那点事"
  },
  {
   "start": 78.34,
   "end": 79.34,
   "text": "他难受的是"
  },
  {
   "start": 79.34,
   "end": 80.34,
   "text": "你什么都不告诉他"
  },
  {
   "start": 80.34,
   "end": 82.34,
   "text": "什么都不跟他说"
  },
  {
   "start": 82.34,
   "end": 83.34,
   "text": "你想想"
  },
  {
   "start": 83.34,
   "end": 85.34,
   "text": "他小时候发高烧"
  },
  {
   "start": 85.34,
   "end": 87.34,
   "text": "是谁背着他去医院的"
  },
  {
   "start": 87.34,
   "end": 89.34,
   "text": "那个时候你麻烦过谁没有"
  },
  {
   "start": 89.34,
   "end": 91.34,
   "text": "你不是怕麻烦他"
  },
  {
   "start": 91.34,
   "end": 95.34,
   "text": "你是怕自己没有用了"
  },
  {
   "start": 95.34,
   "end": 97.34,
   "text": "你以为少麻烦他"
  },
  {
   "start": 97.34,
   "end": 98.34,
   "text": "他就轻松了"
  },
  {
   "start": 98.34,
   "end": 100.34,
   "text": "其实不是的"
  },
  {
   "start": 100.34,
   "end": 102.34,
   "text": "他累的"
  },
  {
   "start": 102.34,
   "end": 103.34,
   "text": "一直都说"
  },
  {
   "start": 103.34,
   "end": 104.34,
   "text": "刚刚我前面说过"
  },
  {
   "start": 104.34,
   "end": 105.34,
   "text": "他累的并不是说"
  },
  {
   "start": 105.34,
   "end": 107.34,
   "text": "你帮他办了点事"
  },
  {
   "start": 107.34,
   "end": 108.34,
   "text": "不对"
  },
  {
   "start": 108.34,
   "end": 110.34,
   "text": "所以人怕的是什么"
  },
  {
   "start": 110.34,
   "end": 112.34,
   "text": "怕的是没有人等着你"
  },
  {
   "start": 112.34,
   "end": 114.34,
   "text": "还有一句话你也要学着说"
  },
  {
   "start": 114.34,
   "end": 116.34,
   "text": "就是那句你居然开口的"
  },
  {
   "start": 116.34,
   "end": 117.34,
   "text": "儿子"
  },
  {
   "start": 117.34,
   "end": 119.34,
   "text": "我这里有一件事情"
  },
  {
   "start": 119.34,
   "end": 122.34,
   "text": "我得请你帮个忙"
  },
  {
   "start": 122.34,
   "end": 124.34,
   "text": "你让他帮你一次"
  },
  {
   "start": 124.34,
   "end": 126.34,
   "text": "他反而心里会很踏实"
  },
  {
   "start": 126.34,
   "end": 130.34,
   "text": "因为他感受到了被你需要"
  },
  {
   "start": 130.34,
   "end": 131.34,
   "text": "对不对"
  },
  {
   "start": 131.34,
   "end": 135.34,
   "text": "是他最想从你这拿到的东西"
  },
  {
   "start": 135.34,
   "end": 137.34,
   "text": "你别小看这件事情"
  },
  {
   "start": 137.34,
   "end": 139.34,
   "text": "人不怕累"
  },
  {
   "start": 139.34,
   "end": 140.34,
   "text": "人不怕累"
  },
  {
   "start": 140.34,
   "end": 143.34,
   "text": "他怕的是没有用"
  },
  {
   "start": 143.34,
   "end": 145.34,
   "text": "而且他没有机会"
  },
  {
   "start": 145.34,
   "end": 147.34,
   "text": "所以不用去怕麻烦他"
  },
  {
   "start": 147.34,
   "end": 148.34,
   "text": "我跟你讲"
  },
  {
   "start": 148.34,
   "end": 150.34,
   "text": "我们这一代人一辈子都在扛"
  },
  {
   "start": 150.34,
   "end": 151.34,
   "text": "特别是我们80后"
  },
  {
   "start": 151.34,
   "end": 153.34,
   "text": "我们80后从小扛到大"
  },
  {
   "start": 153.34,
   "end": 154.34,
   "text": "扛到老"
  },
  {
   "start": 154.34,
   "end": 155.34,
   "text": "对不对"
  },
  {
   "start": 155.34,
   "end": 156.34,
   "text": "扛家里的"
  },
  {
   "start": 156.34,
   "end": 157.34,
   "text": "扛单位的"
  },
  {
   "start": 157.34,
   "end": 158.34,
   "text": "扛孩子"
  },
  {
   "start": 158.34,
   "end": 160.34,
   "text": "到老了最不适应的是"
  },
  {
   "start": 160.34,
   "end": 162.34,
   "text": "没被人照顾"
  },
  {
   "start": 162.34,
   "end": 165.34,
   "text": "也很怕被人照顾"
  },
  {
   "start": 165.34,
   "end": 166.34,
   "text": "可你知道"
  },
  {
   "start": 166.34,
   "end": 167.34,
   "text": "被人惦记"
  },
  {
   "start": 167.34,
   "end": 170.34,
   "text": "并不是你亏欠了谁"
  },
  {
   "start": 170.34,
   "end": 171.34,
   "text": "对不对"
  },
  {
   "start": 171.34,
   "end": 172.34,
   "text": "你也不是欠了谁"
  },
  {
   "start": 172.34,
   "end": 174.34,
   "text": "那是你前半辈子"
  },
  {
   "start": 174.34,
   "end": 177.34,
   "text": "长下来的"
  },
  {
   "start": 177.34,
   "end": 179.34,
   "text": "说到底一句话"
  },
  {
   "start": 179.34,
   "end": 180.34,
   "text": "人老了"
  },
  {
   "start": 180.34,
   "end": 182.34,
   "text": "怕的不是累"
  },
  {
   "start": 182.34,
   "end": 184.34,
   "text": "是没有人等你"
  },
  {
   "start": 184.34,
   "end": 185.34,
   "text": "把这条"
  },
  {
   "start": 185.34,
   "end": 186.34,
   "text": "转发给你的孩子"
  },
  {
   "start": 186.34,
   "end": 187.34,
   "text": "什么话都别说"
  },
  {
   "start": 187.34,
   "end": 189.34,
   "text": "转过去就行"
  },
  {
   "start": 189.34,
   "end": 190.34,
   "text": "他会懂"
  },
  {
   "start": 190.34,
   "end": 191.34,
   "text": "关注老餐"
  },
  {
   "start": 191.34,
   "end": 193.34,
   "text": "平常去说一句"
  },
  {
   "start": 193.34,
   "end": 194.34,
   "text": "你手上"
  },
  {
   "start": 194.34,
   "end": 195.34,
   "text": "有没有一件"
  },
  {
   "start": 195.34,
   "end": 198.34,
   "text": "有人等着你的小算"
  },
  {
   "start": 198.34,
   "end": 199.34,
   "text": "现在讲"
  },
  {
   "start": 199.34,
   "end": 201.34,
   "text": "咱们聊个更往里边的"
  },
  {
   "start": 201.34,
   "end": 202.34,
   "text": "更深的"
  },
  {
   "start": 202.34,
   "end": 203.34,
   "text": "如果遇见"
  },
  {
   "start": 203.34,
   "end": 204.34,
   "text": "二十岁的自己"
  },
  {
   "start": 204.34,
   "end": 206.34,
   "text": "你会跟他说一句什么"
  }
 ]
}