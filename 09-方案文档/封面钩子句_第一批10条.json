{
 "过渡片": "我前面讲错了一件事",
 "A线①": {
  "主": "你以为你睡不着",
  "副": "其实你是不敢睡"
 },
 "A线②": {
  "主": "你冲老婆发的那通火",
  "副": "跟她一点关系都没有"
 },
 "A线③": {
  "主": "一回家就不说话的人",
  "副": "他不是烦你，是不敢说"
 },
 "B线①": {
  "主": "都盼着退休",
  "副": "真退下来的人，最容易垮"
 },
 "B线②": {
  "主": "家里最响的是电视机",
  "副": "那不是陪伴，是填一个洞"
 },
 "B线③": {
  "主": "说了半天，他一句没听进去",
  "副": "不是他不孝，是你问错了"
 },
 "C线①": {
  "主": "孩子一回家就关门",
  "副": "你以为叛逆，其实他在保护你"
 },
 "C线②": {
  "主": "你越问，他越不说",
  "副": "是你第一句，把门锁死了"
 },
 "C线③": {
  "主": "考砸那天，他怕的不是挨骂",
  "副": "是你什么都没说"
